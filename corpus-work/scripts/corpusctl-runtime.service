[Unit]
Description=Bounded human proof corpus executor

[Service]
Type=simple
WorkingDirectory=/disks/sata1/yupeng/human-proof-corpus
ExecStart=/disks/sata1/yupeng/human-proof-corpus/repo/corpus-work/corpusctl serve --max-jobs 3 --poll-seconds 10
Restart=on-failure
RestartSec=5
KillMode=process
UMask=0077

[Install]
WantedBy=default.target
