{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:human-proof-corpus:controller:v2",
  "title": "Corpus controller operational contracts v2",
  "description": "Operational envelopes only. Schema validity never grants mathematical admission, compile success or delivery. Existing corpus/package/PRODUCTION_QUEUE schemas are preserved.",
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Exact artifact path; runtime enforces authorized root, ordinary file/symlink rules and actual scope."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "owner",
        "generation"
      ],
      "additionalProperties": false
    },
    "stage_name": {
      "enum": [
        "cached",
        "source_review",
        "normalized",
        "compiled",
        "page_qa",
        "projected",
        "item_passed"
      ]
    },
    "owner": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "record_type": {
          "const": "owner"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "previous_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "owner",
        "generation",
        "previous_owner",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "problem_id": {
          "$ref": "#/$defs/id"
        },
        "work_key": {
          "type": "string",
          "minLength": 1
        },
        "source_packet": {
          "$ref": "#/$defs/path"
        },
        "workspace": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "problem_id",
        "work_key",
        "source_packet",
        "workspace"
      ],
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "next_block_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          },
          "minItems": 1
        }
      },
      "required": [
        "block_id",
        "enabled",
        "next_block_id",
        "units"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "record_type": {
          "const": "flow"
        },
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        },
        "initial_worker_slots": {
          "const": 3
        },
        "max_worker_slots": {
          "const": 8
        },
        "review_backlog_limit": {
          "const": 25
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "flow_id",
        "blocks",
        "initial_worker_slots",
        "max_worker_slots",
        "review_backlog_limit"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "stdin": {
          "$ref": "#/$defs/path"
        },
        "stdout": {
          "$ref": "#/$defs/path"
        },
        "stderr": {
          "$ref": "#/$defs/path"
        },
        "retry_on_limit": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "argv"
      ],
      "additionalProperties": false
    },
    "job_spec": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "record_type": {
          "const": "job_spec"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "work_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "workspace": {
          "$ref": "#/$defs/path"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          },
          "minItems": 1
        },
        "result_path": {
          "$ref": "#/$defs/path"
        },
        "previous_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "resume_unit_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "job_id",
        "attempt_id",
        "block_id",
        "actor",
        "unit_ids",
        "work_keys",
        "workspace",
        "stages",
        "result_path"
      ],
      "additionalProperties": false
    },
    "ready_refs": {
      "type": "object",
      "properties": {
        "package": {
          "$ref": "#/$defs/path"
        },
        "ready": {
          "$ref": "#/$defs/path"
        },
        "build_root": {
          "$ref": "#/$defs/path"
        },
        "receipt_root": {
          "$ref": "#/$defs/path"
        },
        "item_report": {
          "$ref": "#/$defs/path"
        },
        "page_qa": {
          "$ref": "#/$defs/path"
        },
        "source_map": {
          "$ref": "#/$defs/path"
        },
        "rights": {
          "$ref": "#/$defs/path"
        },
        "difficulty": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "package",
        "ready",
        "build_root",
        "receipt_root",
        "item_report",
        "page_qa",
        "source_map",
        "rights",
        "difficulty"
      ],
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "object",
      "properties": {
        "package": {
          "$ref": "#/$defs/path"
        },
        "ready": {
          "$ref": "#/$defs/path"
        },
        "build_root": {
          "$ref": "#/$defs/path"
        },
        "receipt_root": {
          "$ref": "#/$defs/path"
        },
        "item_report": {
          "$ref": "#/$defs/path"
        },
        "page_qa": {
          "$ref": "#/$defs/path"
        },
        "source_map": {
          "$ref": "#/$defs/path"
        },
        "rights": {
          "$ref": "#/$defs/path"
        },
        "difficulty": {
          "$ref": "#/$defs/path"
        },
        "logs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "unit_result": {
      "type": "object",
      "properties": {
        "problem_id": {
          "$ref": "#/$defs/id"
        },
        "work_key": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "ready_for_review",
            "unfinished",
            "source_hold",
            "engineering_hold"
          ]
        },
        "last_completed_stage": {
          "oneOf": [
            {
              "$ref": "#/$defs/stage_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_stage": {
          "oneOf": [
            {
              "$ref": "#/$defs/stage_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "hold_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "problem_id",
        "work_key",
        "revision",
        "disposition",
        "last_completed_stage",
        "next_stage",
        "next_action",
        "reason_code",
        "reason",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "ready_for_review"
              }
            }
          },
          "then": {
            "properties": {
              "last_completed_stage": {
                "const": "item_passed"
              },
              "next_stage": {
                "type": "null"
              },
              "reason_code": {
                "type": "null"
              },
              "evidence_refs": {
                "$ref": "#/$defs/ready_refs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "unfinished"
              }
            }
          },
          "then": {
            "properties": {
              "next_stage": {
                "$ref": "#/$defs/stage_name"
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "source_hold"
              }
            }
          },
          "then": {
            "required": [
              "hold_evidence"
            ],
            "properties": {
              "next_stage": {
                "type": "null"
              },
              "reason_code": {
                "enum": [
                  "source_ambiguity",
                  "missing_human_proof",
                  "source_version_conflict",
                  "rights_unresolved",
                  "difficulty_insufficient",
                  "semantic_duplicate_pending_review",
                  "source_access_denied"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "hold_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "engineering_hold"
              }
            }
          },
          "then": {
            "required": [
              "hold_evidence"
            ],
            "properties": {
              "reason_code": {
                "enum": [
                  "result_missing",
                  "result_invalid",
                  "compile_failure",
                  "projection_failure",
                  "tool_failure",
                  "unknown_execution_outcome",
                  "transport_failure",
                  "model_quota"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "hold_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "job_result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "record_type": {
          "const": "job_result"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit_result"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "job_id",
        "attempt_id",
        "block_id",
        "finished_at",
        "units"
      ],
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "record_type": {
          "const": "publication"
        },
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "stage": {
          "enum": [
            "frozen",
            "merged",
            "release_prepared",
            "git_staged",
            "commit_ready",
            "pushed",
            "publicly_verified",
            "reconciled"
          ]
        },
        "expected_count": {
          "type": "integer",
          "minimum": 1
        },
        "incoming_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "expected_remote_base": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "server_parent": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_tree": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_commit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_public_result": {
          "$ref": "#/$defs/path"
        },
        "receipt_paths": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "started_by": {
          "$ref": "#/$defs/actor"
        },
        "actor_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor"
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "batch_id",
        "actor",
        "stage",
        "expected_count",
        "incoming_ids",
        "remote",
        "branch",
        "expected_remote_base",
        "server_parent",
        "expected_tree",
        "target_commit",
        "bundle_path",
        "previous_public_result",
        "receipt_paths",
        "started_by",
        "actor_history"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "commit_ready",
                  "pushed",
                  "publicly_verified",
                  "reconciled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "server_parent": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "expected_tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "target_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "bundle_path": {
                "$ref": "#/$defs/path"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "publicly_verified",
                  "reconciled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "receipt_paths": {
                "required": [
                  "public_result"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "git_staged",
                  "commit_ready",
                  "pushed",
                  "publicly_verified",
                  "reconciled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "server_parent": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "expected_tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      ]
    },
    "base_reference": {
      "type": "object",
      "properties": {
        "package": {
          "$ref": "#/$defs/path"
        },
        "build_root": {
          "$ref": "#/$defs/path"
        },
        "receipt_root": {
          "$ref": "#/$defs/path"
        },
        "accepted_report": {
          "$ref": "#/$defs/path"
        },
        "local_count": {
          "type": "integer",
          "minimum": 0
        },
        "remote_main_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "package",
        "build_root",
        "receipt_root",
        "accepted_report",
        "local_count",
        "remote_main_count"
      ],
      "additionalProperties": true
    },
    "active_batch": {
      "type": "object",
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "batch_dir": {
          "$ref": "#/$defs/path"
        },
        "frozen_base": {
          "$ref": "#/$defs/base_reference"
        },
        "expected_count": {
          "type": "integer",
          "minimum": 1
        },
        "incoming_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "batch_id",
        "batch_dir",
        "frozen_base",
        "expected_count",
        "incoming_ids",
        "created_at"
      ],
      "additionalProperties": false
    },
    "last_publication": {
      "type": "object",
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "result_path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "batch_id",
        "commit",
        "count",
        "result_path"
      ],
      "additionalProperties": false
    },
    "queue_extension": {
      "type": "object",
      "properties": {
        "active_batch": {
          "oneOf": [
            {
              "$ref": "#/$defs/active_batch"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_publication": {
          "oneOf": [
            {
              "$ref": "#/$defs/last_publication"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "active_batch",
        "last_publication"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/owner"
    },
    {
      "$ref": "#/$defs/flow"
    },
    {
      "$ref": "#/$defs/job_spec"
    },
    {
      "$ref": "#/$defs/job_result"
    },
    {
      "$ref": "#/$defs/publication"
    }
  ]
}
