Cell[BoxData[
 RowBox[{
  RowBox[{"ProduceConstants", "[", "sumL_List", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"step", ",", "varInd"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"step", "=", 
        RowBox[{"GetDefinition", "[", 
         RowBox[{"sumL", "[", 
          RowBox[{"[", "kk", "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"varInd", "=", 
        RowBox[{"step", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"step", "=", 
        RowBox[{"ComputeGeneratingFunction", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"step", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ")"}], "//", "ToMathematica"}], 
          ",", "x", ",", 
          RowBox[{"{", 
           RowBox[{"varInd", ",", "1", ",", "\[Infinity]"}], "}"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"step", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"step", "/.", 
            RowBox[{"x", "\[Rule]", "1"}]}], "//", "SpecialGLToH"}], "//", 
          "Expand"}], "//", "GLToH"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"step", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"step", "/.", "hrel"}], "/.", "constrel"}], "//", 
         "Expand"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"step", "=", 
        RowBox[{
         RowBox[{"ReduceConstants", "[", 
          RowBox[{"step", ",", 
           RowBox[{"ToKnownConstants", "->", "True"}]}], "]"}], "//", 
         "Expand"}]}], ";", "\[IndentingNewLine]", "step"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"kk", ",", "1", ",", 
        RowBox[{"Length", "[", "sumL", "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

 CellChangeTimes->{{3.983861789380732*^9, 3.983861792363957*^9}, {
