            SuperscriptBox["m", "10"]}], "+", 
           RowBox[{"10368", " ", "k", " ", 
            SuperscriptBox["m", "10"]}], "-", 
           RowBox[{"1728", " ", 
            SuperscriptBox["m", "11"]}]}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"S", "[", 
           RowBox[{"1", ",", "k"}], "]"}], "2"]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "3"}], "+", "k", "-", "m"}], ")"}], "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "2"}], "+", "k", "-", "m"}], ")"}], "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "k", "-", "m"}], ")"}], "2"]}], 
        ")"}]}]}], ")"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9937008158544617`*^9, 3.993700826691214*^9}, 
   3.99370402532369*^9, 3.9937103686159487`*^9, 3.9937139226585417`*^9, 
