 CellLabel->
  "(2) Out[8]=",ExpressionUUID->"c0a62374-a9e6-4e93-b6d9-273ca41b617d"]
}, Open  ]],

Cell["\<\
More precisely, if we denote summand of the inner sum by f[m,k] \
\>", "Text",
 CellChangeTimes->{{3.993704026975459*^9, 3.9937040866984587`*^9}, {
  3.993710643669848*^9, 
  3.9937106639604073`*^9}},ExpressionUUID->"18eb702d-8151-48a2-82bd-\
4a080f2a3fca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"f", "=", 
  RowBox[{"innerSum", "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellLabel->
  "(2) In[9]:=",ExpressionUUID->"6552fdcc-78fd-4850-8bfc-9cb9b45cd480"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"(", 
    SuperscriptBox[
     RowBox[{"(", GridBox[{
        {"m"},
        {"k"}
       }], ")"}], "."], ")"}], "2"], " ", 
  SuperscriptBox[
   RowBox[{"S", "[", 
    RowBox[{"1", ",", "k"}], "]"}], "2"]}]], "Output",
 CellChangeTimes->{3.993704090753037*^9, 3.993710368985936*^9, 
  3.993713925101101*^9, 3.993719658821789*^9, 3.993720560717712*^9, 
  3.993721952900694*^9, 3.9937233706513557`*^9},
 CellLabel->
  "(2) Out[9]=",ExpressionUUID->"2d16421e-1e25-43b0-83b0-f0c5d29125ee"]
}, Open  ]],

Cell["the following summand recurrence ", "Text",
 CellChangeTimes->{{3.993704095130507*^9, 3.993704102927623*^9}, {
  3.993710670347891*^9, 
  3.993710678961137*^9}},ExpressionUUID->"af042d50-cd84-43f6-a94b-\
bbce1964643b"],

Cell["\<\
c0 f[m, k] + c1 f[m+ 1, k] + c2 f[m + 2, k] + c3 f[m + 3, k] == g[m, k + 1] - \
g[m, k]        (*)\
\>", "Text",
 CellChangeTimes->{{3.993700849879122*^9, 3.9937009057994623`*^9}, {
  3.993701009918436*^9, 3.993701028085616*^9}, {3.9937041157903833`*^9, 
  3.993704122476651*^9}, {3.993704222987259*^9, 
  3.993704225957796*^9}},ExpressionUUID->"0295c7da-7576-404e-96e5-\
4616b0f19859"],

Cell["\<\
holds for all k and m with 0 <= k <= m and m >= 0. This can be checked as \
follows:\
\>", "Text",
 CellChangeTimes->{{3.993704106503298*^9, 3.993704195020109*^9}, {
  3.9937106832055693`*^9, 
  3.9937107082904*^9}},ExpressionUUID->"6153da3b-d462-48d7-8336-101863c3ffc2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"c0", " ", "f"}], "+", 
   RowBox[{"c1", " ", 
    RowBox[{"NShift", "[", 
     RowBox[{"f", ",", "m"}], "]"}]}], "+", 
   RowBox[{"c2", " ", 
    RowBox[{"NShift", "[", 
     RowBox[{"f", ",", "m", ",", "2"}], "]"}]}], "+", 
   RowBox[{"c3", " ", 
    RowBox[{"NShift", "[", 
     RowBox[{"f", ",", "m", ",", "3"}], "]"}]}], "-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"NShift", "[", 
      RowBox[{"g", ",", "k"}], "]"}], "-", "g"}], ")"}]}], "//", 
  "Together"}]], "Input",
 CellChangeTimes->{{3.993700917927363*^9, 3.993701003560966*^9}},
 CellLabel->
  "(2) In[10]:=",ExpressionUUID->"e115aaa5-75c9-4821-a82d-2416535a09f2"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{{3.9937009828361053`*^9, 3.993701004521998*^9}, 
   3.993704203585496*^9, 3.993710369205159*^9, 3.9937139275908203`*^9, 
   3.9937196628133183`*^9, 3.9937205609445667`*^9, 3.9937219531178493`*^9, 
   3.993723370869259*^9},
 CellLabel->
  "(2) Out[10]=",ExpressionUUID->"3b6793fe-1aee-42d1-9496-2276aaa5d0fd"]
}, Open  ]],

Cell["\<\
Finally, summing the summand recurrence (*) over k from 0 to m yields the \
above recurrence.\
\>", "Text",
 CellChangeTimes->{{3.9937042065203753`*^9, 
  3.993704270247086*^9}},ExpressionUUID->"d0e2c110-1c24-4446-b103-\
8a253e819f34"]
}, Open  ]],

