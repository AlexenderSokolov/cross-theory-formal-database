Cell["we will simplify the double sum", "Text",
 CellChangeTimes->{{3.993703676315847*^9, 3.993703712516552*^9}, {
  3.993710471617754*^9, 
  3.993710475812602*^9}},ExpressionUUID->"4ba18a00-084c-43b6-bacb-\
405405a0d419"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mySum", "=", 
  RowBox[{"SigmaSum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SigmaSum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"SigmaBinomial", "[", 
           RowBox[{"m", ",", "k"}], "]"}], "^", "2"}], 
         RowBox[{
          RowBox[{"S", "[", 
           RowBox[{"1", ",", "k"}], "]"}], "^", "2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "m"}], "}"}]}], "]"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "+", "1"}], ")"}], "^", "2"}]}], "/", 
     RowBox[{"SigmaBinomial", "[", 
      RowBox[{
       RowBox[{"2", "m"}], ",", "m"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9936273074310017`*^9, 3.993627346125784*^9}, {
  3.993627383964172*^9, 3.993627389596711*^9}, {3.993628335006382*^9, 
  3.993628339000928*^9}, {3.993628377559894*^9, 3.993628414015553*^9}},
 CellLabel->
  "(2) In[4]:=",ExpressionUUID->"43ccc43e-7a41-40ed-8a57-ad232842443e"],

Cell[BoxData[
 RowBox[{
  UnderoverscriptBox[
   SuperscriptBox["\[Sum]", "."], 
   RowBox[{"m", "=", "0"}], "\[Infinity]"], 
  FractionBox[
   RowBox[{
    UnderoverscriptBox[
     SuperscriptBox["\[Sum]", "."], 
     RowBox[{"k", "=", "0"}], "m"], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox[
        RowBox[{"(", GridBox[{
           {"m"},
           {"k"}
          }], ")"}], "."], ")"}], "2"], " ", 
     SuperscriptBox[
      RowBox[{"S", "[", 
       RowBox[{"1", ",", "k"}], "]"}], "2"]}]}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "m"}], ")"}], "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", GridBox[{
        {
         RowBox[{"2", " ", "m"}]},
        {"m"}
       }], ")"}], "."]}]]}]], "Output",
 CellChangeTimes->{{3.993628392942574*^9, 3.9936284143241*^9}, 
   3.993700588623096*^9, 3.993703714862917*^9, 3.993710243642563*^9, 
   3.99371217530667*^9, 3.993719368549428*^9, 3.9937196293265142`*^9, 
   3.993720305188485*^9, 3.993720432313817*^9, 3.9937218228556232`*^9, 
   3.9937232425223703`*^9},
 CellLabel->
  "(2) Out[4]=",ExpressionUUID->"5cd024dc-b196-44dc-a7d4-c647186e04ed"]
}, Open  ]],

Cell["to", "Text",
 CellChangeTimes->{{3.993710267485465*^9, 
  3.99371027662914*^9}},ExpressionUUID->"9cacf3d1-971e-4b2b-b3cc-\
2acbc30d5dbd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"20", " ", "li4half"}], "+", 
  FractionBox[
   RowBox[{"5", " ", 
    SuperscriptBox["ln2", "4"]}], "6"], "+", 
  RowBox[{"10", " ", "z2"}], "-", 
  FractionBox[
   RowBox[{"65", " ", 
    SuperscriptBox["z2", "2"]}], "9"], "-", 
  RowBox[{
   SuperscriptBox["ln2", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"12", "+", 
     RowBox[{"5", " ", "z2"}]}], ")"}]}], "+", 
  FractionBox["z3", "2"], "+", 
  RowBox[{"ln2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "16"}], "+", 
     FractionBox[
      RowBox[{"35", " ", "z3"}], "2"]}], ")"}]}]}]], "Text",
 CellChangeTimes->{
  3.993710430434106*^9},ExpressionUUID->"1b918e6e-b997-4e78-97ad-\
cf1f71e25348"],

Cell["\<\
Note : ln2 = Log[2], z2 = Zeta[2] and li4half = PolyLog[4, 1/2]\
\>", "Text",
 CellChangeTimes->{{3.9937082547408333`*^9, 3.993708258451915*^9}, 
   3.9937104915606937`*^9},ExpressionUUID->"9e0a914a-a00e-45d9-93c1-\
a4d45aa0cdf3"],

Cell["\<\
Here will perform two steps: In a first round we simplify automatically the \
double sum  in terms of known constants and two infinite binomial sums. In \
the second step also these unsimplified binomial sums are reduced to known \
constants; this can be done  also automatically, but an extra step has to be \
carried out by a new function definition.\
\>", "Text",
 CellChangeTimes->{{3.993711915818604*^9, 3.993712145908596*^9}, {
  3.993722492505064*^9, 3.993722494987687*^9}, {3.993722529234912*^9, 
  3.9937225383493567`*^9}},ExpressionUUID->"033aac9c-719a-407e-94c5-\
23d58c9c9ef6"],

Cell["\<\
We remark that this machinery is rather general and allows one to tackle \
similar problems fully automatically using the summation machinery Sigma and \
HarmonicSums.\
\>", "Text",
 CellChangeTimes->{{3.993710158700292*^9, 
  3.99371019936618*^9}},ExpressionUUID->"5f6b4919-e85b-4bdb-8b4f-\
b65936d88336"],

Cell[CellGroupData[{

Cell["A representation in terms of infinite binomials sums", "Subtitle",
 CellChangeTimes->{{3.993700560043367*^9, 
  3.993700583408699*^9}},ExpressionUUID->"aa4008f9-1a88-4714-892e-\
443eb4beb000"],

Cell["First we use our symbolic summation machinery and get", "Text",
 CellChangeTimes->{{3.984208977629477*^9, 3.9842089845324297`*^9}, {
  3.993703734653372*^9, 
  3.993703750677836*^9}},ExpressionUUID->"fb1ecc10-9904-4a9a-9e6f-\
436369ac1e9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resInfiniteBinSum", "=", 
  RowBox[{
   RowBox[{"EvaluateMultiSum", "[", 
    RowBox[{"mySum", ",", 
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "}"}]}], "]"}], "/.", 
   RowBox[{"LinInf", "->", "Infinity"}]}]}]], "Input",
 CellChangeTimes->{{3.993700610394703*^9, 3.993700635669705*^9}, {
  3.993702782338129*^9, 3.993702786649214*^9}},
 CellLabel->
  "(2) In[5]:=",ExpressionUUID->"a47349d6-9c93-4d46-b6c1-58b1a72e8f05"],

Cell[BoxData["\<\"Loading Relations...\"\>"], "Print",
 CellChangeTimes->{3.9937204638684196`*^9, 3.993721854006269*^9, 
  3.993723273849476*^9},
 CellLabel->
  "During evaluation of (2) \
In[5]:=",ExpressionUUID->"f54b494b-946d-47a8-9a80-9d54d23e891a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"20", " ", "li4half"}], "+", 
  FractionBox[
   RowBox[{"5", " ", 
    SuperscriptBox["ln2", "4"]}], "6"], "+", 
  RowBox[{
   SuperscriptBox["ln2", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "12"}], "-", 
     RowBox[{"5", " ", "z2"}]}], ")"}]}], "-", 
  FractionBox[
   RowBox[{"38", " ", 
    SuperscriptBox["z2", "2"]}], "5"], "+", 
  FractionBox["z3", "2"], "+", 
  RowBox[{"ln2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "16"}], "+", 
     FractionBox[
      RowBox[{"35", " ", "z3"}], "2"]}], ")"}]}], "+", 
  RowBox[{"z2", " ", 
   RowBox[{"(", 
    RowBox[{"10", "+", 
     RowBox[{"3", " ", 
      RowBox[{"(", 
       RowBox[{
        UnderoverscriptBox[
         SuperscriptBox["\[Sum]", "."], 
         RowBox[{
          SubscriptBox["\[Iota]", "1"], "=", "1"}], "\[Infinity]"], 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["\[Iota]", "1"], 
            SubscriptBox["!", "."]}], ")"}], "2"], 
         RowBox[{
          SubsuperscriptBox["\[Iota]", "1", "2"], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", " ", 
             SubscriptBox["\[Iota]", "1"]}], ")"}], 
           SubscriptBox["!", "."]}]}]]}], ")"}]}]}], ")"}]}], "-", 
  RowBox[{"3", " ", 
   RowBox[{"(", 
    RowBox[{
     UnderoverscriptBox[
      SuperscriptBox["\[Sum]", "."], 
      RowBox[{
       SubscriptBox["\[Iota]", "1"], "=", "1"}], "\[Infinity]"], 
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Iota]", "1"], 
          SubscriptBox["!", "."]}], ")"}], "2"], " ", 
       RowBox[{"S", "[", 
        RowBox[{"2", ",", 
         SubscriptBox["\[Iota]", "1"]}], "]"}]}], 
      RowBox[{
       SubsuperscriptBox["\[Iota]", "1", "2"], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", 
          SubscriptBox["\[Iota]", "1"]}], ")"}], 
        SubscriptBox["!", "."]}]}]]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.993700655611246*^9, 3.9937028070401487`*^9, 
  3.993703880751932*^9, 3.993710360364197*^9, 3.993713905901105*^9, 
  3.993719543417008*^9, 3.993720552723117*^9, 3.993721944746896*^9, 
  3.993723362444648*^9},
 CellLabel->
  "(2) Out[5]=",ExpressionUUID->"c8e0af52-98ce-4ae8-8a69-45c82b9294fd"]
}, Open  ]],

Cell["\<\
Details of the calculation can be found in the next subsection.\
\>", "Text",
 CellChangeTimes->{{3.99370377709708*^9, 
  3.9937037955070868`*^9}},ExpressionUUID->"9a1efb26-bbe2-49de-ac46-\
7cdb8e4c6997"],

Cell[CellGroupData[{

Cell["Details (with a CA proof)", "Section",
 CellChangeTimes->{{3.993700739681157*^9, 
  3.9937007581577377`*^9}},ExpressionUUID->"0ebf3a36-f221-43a3-8f31-\
23aa2253aaf9"],

Cell["\<\
We first look at the inner sum and afterwards turn to the outermost sum. For \
further 
details of the underlying machinery we refer to
\[LineSeparator]C. Schneider Symbolic Summation Assists Combinatorics. Sem. \
Lothar. Combin. 56, pp. 1-36. 2007. ISSN 1286-4889. Article B56b.

C. Schneider Term Algebras, Canonical Representations and Difference Ring \
Theory for Symbolic Summation. In: Anti-Differentiation and the Calculation \
of Feynman Amplitudes, J. Bl\[UDoubleDot]mlein and C. Schneider (ed.), Texts \
and Monographs in Symbolic Computuation , pp. 423-485. 2021.

J. Ablinger, J. Bl\[UDoubleDot]mlein and C. Schneider. Harmonic Sums and \
Polylogarithms Generated by Cyclotomic Polynomials. J. Math. Phys. 52 (2011) \
102301. arXiv:1105.6063 [math-ph].\
\>", "Text",
 CellChangeTimes->{{3.9937038011608353`*^9, 3.993703821438341*^9}, {
  3.9937086723330593`*^9, 3.993708731511711*^9}, {3.993708808674704*^9, 
  3.993708839901588*^9}},ExpressionUUID->"8bc61697-8a61-4de8-8b69-\
1d18fb333bc1"],

Cell[CellGroupData[{

Cell["Dealing with the inner sum", "Subsection",
 CellChangeTimes->{{3.993627492554573*^9, 
  3.993627497182055*^9}},ExpressionUUID->"a9f572f4-8047-4e30-adf7-\
ea632827ee3c"],

Cell["To simplify the inner sum", "Text",
 CellChangeTimes->{{3.9937038304219437`*^9, 3.993703832669175*^9}, {
  3.99371054293069*^9, 
  3.993710547096052*^9}},ExpressionUUID->"0c057ed1-4d93-4a03-bea0-\
f481611b0ab5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"innerSum", "=", 
  RowBox[{"mySum", "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "3"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.993627505493519*^9, 3.993627511233549*^9}, {
  3.993627681031247*^9, 3.99362768115663*^9}, {3.993628421658389*^9, 
  3.993628430639044*^9}},
 CellLabel->
  "(2) In[6]:=",ExpressionUUID->"503e1343-e8ec-4863-af5b-599f3368cb0a"],

Cell[BoxData[
 RowBox[{
  UnderoverscriptBox[
   SuperscriptBox["\[Sum]", "."], 
   RowBox[{"k", "=", "0"}], "m"], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox[
      RowBox[{"(", GridBox[{
         {"m"},
         {"k"}
        }], ")"}], "."], ")"}], "2"], " ", 
   SuperscriptBox[
    RowBox[{"S", "[", 
     RowBox[{"1", ",", "k"}], "]"}], "2"]}]}]], "Output",
 CellChangeTimes->{
  3.993627530185305*^9, 3.993627681749264*^9, {3.993628418057704*^9, 
   3.993628431068925*^9}, 3.993700767652381*^9, 3.993703880963882*^9, 
   3.9937103607899218`*^9, 3.99371390981878*^9, 3.993719642290132*^9, 
   3.993720553072679*^9, 3.993721944887206*^9, 3.9937233628762283`*^9},
 CellLabel->
  "(2) Out[6]=",ExpressionUUID->"104c84fa-03f9-491d-9310-ab5354b5f7d9"]
}, Open  ]],

Cell["\<\
we will utilize the Sigma summation spiral: (1) compute a recurrence via \
Zeilberger\[CloseCurlyQuote]s creative telescoping paradigm, (2) solve the \
recurrence in terms of indefinite nested sums and (3) combine the solutions \
to obtain a closed form.\
\>", "Text",
 CellChangeTimes->{{3.993703841296604*^9, 3.993703921657407*^9}, {
  3.993710552499014*^9, 
  3.993710574027749*^9}},ExpressionUUID->"fdb24ea3-a8da-48e9-936d-\
6c5710009270"],

Cell[CellGroupData[{

Cell["\<\
Computing a recurrence via Zeilberger\[CloseCurlyQuote]s creative telescoping \
paradigm\
\>", "Subsubsection",
 CellChangeTimes->{{3.993701056562469*^9, 3.993701080644844*^9}, 
   3.993703933050165*^9},ExpressionUUID->"55dff524-a9cf-48da-97ef-\
a6cd2ee70088"],

Cell["\<\
We can compute a recurrence for SUM[m]=innerSum with Sigma as follows:\
\>", "Text",
 CellChangeTimes->{{3.993703943155881*^9, 3.9937039591083097`*^9}, {
  3.993710584047764*^9, 
  3.993710599984001*^9}},ExpressionUUID->"90df54f4-1d40-48d2-a782-\
f40aac5e055d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rec", "=", 
  RowBox[{
   RowBox[{"GenerateRecurrence", "[", "innerSum", "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9936276877097197`*^9, 3.993627706315494*^9}, {
  3.9937012629093227`*^9, 3.993701263493013*^9}},
 CellLabel->
  "(2) In[7]:=",ExpressionUUID->"f210769e-ed84-4ff6-867a-acc49a7a566b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"8", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "m"}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "m"}]}], ")"}], "3"], " ", 
    RowBox[{"(", 
     RowBox[{"735", "+", 
      RowBox[{"1621", " ", "m"}], "+", 
      RowBox[{"1332", " ", 
       SuperscriptBox["m", "2"]}], "+", 
      RowBox[{"480", " ", 
       SuperscriptBox["m", "3"]}], "+", 
      RowBox[{"64", " ", 
       SuperscriptBox["m", "4"]}]}], ")"}], " ", 
    RowBox[{"SUM", "[", "m", "]"}]}], "-", 
   RowBox[{"4", " ", 
    RowBox[{"(", 
     RowBox[{"4533", "+", 
      RowBox[{"33460", " ", "m"}], "+", 
      RowBox[{"106442", " ", 
       SuperscriptBox["m", "2"]}], "+", 
      RowBox[{"183201", " ", 
       SuperscriptBox["m", "3"]}], "+", 
      RowBox[{"186452", " ", 
       SuperscriptBox["m", "4"]}], "+", 
      RowBox[{"115708", " ", 
       SuperscriptBox["m", "5"]}], "+", 
      RowBox[{"43056", " ", 
       SuperscriptBox["m", "6"]}], "+", 
      RowBox[{"8832", " ", 
       SuperscriptBox["m", "7"]}], "+", 
      RowBox[{"768", " ", 
       SuperscriptBox["m", "8"]}]}], ")"}], " ", 
    RowBox[{"SUM", "[", 
     RowBox[{"1", "+", "m"}], "]"}]}], "+", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{"2", "+", "m"}], ")"}], " ", 
    RowBox[{"(", 
