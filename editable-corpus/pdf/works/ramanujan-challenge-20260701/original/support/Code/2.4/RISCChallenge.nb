Cell["\<\
To handle the limit properly, we compute for each sum its asymptotic \
expansion using the HarmonicSums command SExpansion. In addition, we reduce \
the occurring constants with the HarmonicSums-command ReduceConstants. For \
details see \[LineSeparator]J. Ablinger, J. Bl\[UDoubleDot]mlein and C. \
Schneider. Harmonic Sums and Polylogarithms Generated by Cyclotomic \
Polynomials. J. Math. Phys. 52 (2011) 102301. arXiv:1105.6063 [math-ph].\
\>", "Text",
 CellChangeTimes->{{3.993707483501548*^9, 3.993707582451532*^9}, {
  3.99370888198698*^9, 3.993708890127787*^9}, {3.9937111317054987`*^9, 
  3.9937111716171217`*^9}},ExpressionUUID->"0ae4f349-bb50-4e2a-9bcb-\
cafb1b8e9f1e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"varExp", "=", 
   RowBox[{"SExpansion", "[", 
    RowBox[{"var", ",", "A", ",", "2"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"varExp", "=", 
   RowBox[{"ReduceConstants", "[", " ", 
    RowBox[{"varExp", ",", 
     RowBox[{"ToKnownConstants", "->", "Automatic"}], ",", 
     RowBox[{"Online", "->", "Automatic"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"substExp", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{"Rule", ",", 
     RowBox[{"{", 
      RowBox[{"var", ",", "varExp"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{"substExp", "//", 
   RowBox[{
    RowBox[{"MatrixForm", "[", 
     RowBox[{"#", ",", 
      RowBox[{"TableAlignments", "->", "Left"}]}], "]"}], "&"}]}]}]}], "Input",\

 CellChangeTimes->{{3.9936435363278227`*^9, 3.993643580289814*^9}, {
   3.993690266532042*^9, 3.9936902828103943`*^9}, {3.99369034390035*^9, 
