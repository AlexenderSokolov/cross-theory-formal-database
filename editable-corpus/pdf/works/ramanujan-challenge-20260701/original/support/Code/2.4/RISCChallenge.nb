       SqrtBox[
        RowBox[{"4", "-", "VarGL"}]], " ", 
       SqrtBox["VarGL"]}], ",", 
      RowBox[{
       SqrtBox[
        RowBox[{"4", "-", "VarGL"}]], " ", 
       SqrtBox["VarGL"]}]}], "}"}], ",", "x"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.993703229294455*^9, 3.9937032386382093`*^9}},
 CellLabel->
  "(2) In[47]:=",ExpressionUUID->"815f08bf-41f1-4516-a970-bacf68062457"],

Cell[BoxData[
 TagBox[
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "x"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", 
     SubscriptBox["\[Tau]", "1"]], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", 
      SubscriptBox["\[Tau]", "2"]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", 
       SubscriptBox["\[Tau]", "3"]], 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"4", "-", 
          SubscriptBox["\[Tau]", "1"]}]], " ", 
        SqrtBox[
         SubscriptBox["\[Tau]", "1"]], " ", 
        SqrtBox[
         RowBox[{"4", "-", 
          SubscriptBox["\[Tau]", "2"]}]], " ", 
        SqrtBox[
         SubscriptBox["\[Tau]", "2"]], " ", 
        SqrtBox[
         RowBox[{"4", "-", 
          SubscriptBox["\[Tau]", "3"]}]], " ", 
        SqrtBox[
         SubscriptBox["\[Tau]", "3"]], " ", 
        SqrtBox[
         RowBox[{"4", "-", 
          SubscriptBox["\[Tau]", "4"]}]], " ", 
        SqrtBox[
         SubscriptBox["\[Tau]", "4"]]}], 
       RowBox[{"\[DifferentialD]", 
        SubscriptBox["\[Tau]", "4"]}], 
       RowBox[{"\[DifferentialD]", 
        SubscriptBox["\[Tau]", "3"]}], 
       RowBox[{"\[DifferentialD]", 
        SubscriptBox["\[Tau]", "2"]}], 
