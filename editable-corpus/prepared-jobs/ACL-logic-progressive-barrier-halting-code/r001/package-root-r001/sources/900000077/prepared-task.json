  "standard_prerequisites": [
    {
      "name": "Classical computability tools",
      "statement": "The halting set has a monotone left-c.e. modulus; the uniform relativized limit lemma removes one jump by one extra coordinate; a function dominating a modulus computes the set."
    },
    {
      "name": "Classical finite-order barrier characterization",
      "statement": "Assous PropositionII.1: a barrier has order type at most omega^n exactly when its member sizes are bounded by n. The source omega-bounded equivalence is supplied as local proof support."
    }
  ],
  "core_obligations": [
    "Build a computable barrier whose tail length tracks a left-c.e. modulus of the halting set, and establish barrier comparability and order-type control.",
    "Build the uniform finite-jump thin colorings with their oracle-removal dimension shift, then translate them into a progressive coloring on the variable-length barrier.",
    "Decode the halting set either from a thin tail or from forced gaps in every infinite free set, which dominate the chosen modulus."
  ],
