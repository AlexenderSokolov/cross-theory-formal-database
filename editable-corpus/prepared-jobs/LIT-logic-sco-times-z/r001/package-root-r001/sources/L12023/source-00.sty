\providecommand\vvee{\hstretch{.8}{\vee\mkern-8mu\vee}}       % "double vee"
\providecommand\wwedge{\hstretch{.8}{\wedge\mkern-8mu\wedge}} % "double wedge"
\renewcommand{\phi}{\varphi}
\providecommand{\bigwwedge}{%
  \mathop{
    \mathchoice{\bigwedge\mkern-15mu\bigwedge}
               {\bigwedge\mkern-12.5mu\bigwedge}
               {\bigwedge\mkern-12.5mu\bigwedge}
               {\bigwedge\mkern-11mu\bigwedge}
    }
}

\providecommand{\bigvvee}{%
  \mathop{
    \mathchoice{\bigvee\mkern-15mu\bigvee}
               {\bigvee\mkern-12.5mu\bigvee}
               {\bigvee\mkern-12.5mu\bigvee}
               {\bigvee\mkern-11mu\bigvee}
    }
}

