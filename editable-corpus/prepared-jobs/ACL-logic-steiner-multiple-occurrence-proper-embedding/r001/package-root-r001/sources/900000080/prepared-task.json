  "standard_prerequisites": [
    {
      "name": "Elementary universal algebra and well-founded recursion",
      "statement": "Universal mapping property, generated subalgebras, uniqueness of a homomorphism on generators, and recursion/induction on well-orders."
    },
    {
      "name": "Finite combinatorial accounting on terms and triples",
      "statement": "Term length and rank, counting blocks by their greatest vertex, and monotone nonnegative integer sequences."
    }
  ],
  "core_obligations": [
    "Prove reduced substitution is syntactically injective and preserves reducedness when the substituted variable occurs in both top factors, excluding all cancellation patterns by term lengths.",
    "Use the full rank/normal-form theorem to deduce injectivity of the induced homomorphism and exclude the old generator from its image.",
    "Factor a general multiple-occurrence term into a two-branch reduced substitution followed by a single-occurrence automorphism, preserving properness and excluding every single-occurrence term from the image."
  ],
