\ProvidesPackage{aumacros}

%% Math macros

\newcommand{\im}{\mathop{\mathrm{im}}}
\newcommand{\toiso}{\xrightarrow{\thicksim}}
\newcommand{\rank}{\mathop{\mathrm{rank}}}
\newcommand{\T}{\intercal}

\newcommand{\sgn}{\ensuremath{\mathrm{sign}}}
\newcommand{\floor}[1]{\ensuremath{\left\lfloor{#1}\right\rfloor}}

\newcommand{\FF}{\@ifstar{\FF@star}{\FF@nostar}}
  \newcommand{\FF@star}[1]{\ensuremath{\mathbb{#1}}}
  \newcommand{\FF@nostar}{\FF@star{F}}
\newcommand{\FFext}{\@ifstar{\FFext@star}{\FFext@nostar}}
  \newcommand{\FFext@star}[1]{\ensuremath{\widehat{\mathbb{#1}}}}
  \newcommand{\FFext@nostar}{\FFext@star{F}}

\newcommand{\linspan}{\ensuremath{\mathop{\mathrm{span}}}}

\newcommand{\wedgec}{\raisebox{-0.1pt}{\hskip 1pt{\tiny $\wedge$}\hskip 1pt}}
\newcommand{\wcdots}{\raisebox{-1pt}{$\cdots$}}
\newcommand{\wedgecdots}{\wedgec\wcdots\wedgec}
\newcommand{\bdry}{\partial}

\newcommand{\Gen}{\@ifstar{\Gen@star}{\Gen@nostar}}
  \newcommand{\Gen@star}[1]{\mathrm{#1}}
  \newcommand{\Gen@nostar}{\Gen@star{G}}

\newcommand{\Class}{\mathcal{C}}

\newcommand{\RFE}{\Gen*{RFE}}
\newcommand{\RFEparam}[2]{\RFE^{#1}_{#2}}
\newcommand{\RFEkl}{\RFEparam{k}{l}}
\newcommand{\RFElml}{\RFEparam{l-1}{l}}
\newcommand{\SV}{\Gen*{SV}}
\newcommand{\SVnonnorm}{\widetilde{\SV}}
\newcommand{\SVparam}[1]{{\SV}^{#1}}
\newcommand{\SVl}{\SVparam{l}}
\newcommand{\Ideal}[1]{{\ensuremath{\mathrm{#1}}}}
\newcommand{\VanIdeal}[1]{{\ensuremath{\Ideal{Van}[#1]}}}
\newcommand{\VanGen}{{\ensuremath{\mathrm{EVC}}}}
\newcommand{\VanGenparam}[2]{{\ensuremath{\VanGen^{#1}_{#2}}}}
\newcommand{\VanGenkl}{\VanGenparam{k}{l}}
\newcommand{\SMVanOne}{{\ensuremath{\mathrm{ESMVC}}}}
\newcommand{\SMVanOneparam}[2]{{\ensuremath{\SMVanOne^{#1}_{#2}}}}
\newcommand{\SMVanOnekl}{\SMVanOneparam{k}{l}}

\newcommand{\exterior}{\ensuremath{\Lambda}}
\newcommand{\SimplicesBase}{\exterior}
\newcommand{\Simplicesparam}[1]{\SimplicesBase^{#1}(\SpanVertices)}
\newcommand{\Simplices}{\Simplicesparam{*}}
\newcommand{\Vertices}{\ensuremath{V}}
\newcommand{\SpanVertices}{\ensuremath{U}}
\newcommand{\Simplicest}{\Simplicesparam{t}}
\newcommand{\Simplicesl}{\Simplicesparam{l}}
\newcommand{\Simplicesd}{\Simplicesparam{d}}
\newcommand{\ExtSimplicesparam}[1]{\widehat{\SimplicesBase}^{#1}(\SpanVertices)}
\newcommand{\ExtSimplicest}{\ExtSimplicesparam{t}}
\newcommand{\Vdet}[1]{\left|#1\right|_a}
\newcommand{\Srepr}{\rho}

\newcommand{\CMat}[2]{\mathrm{CMat}_{#1,#2}}
\newcommand{\PartialZero}[3]{\left.\partial_{#1} #3\right|_{#2 \gets 0}}
\newcommand{\PartialZeroPrime}[3]{\left.\partial'_{#1} #3\right|_{#2 \gets 0}}

\newcommand{\minsplitdeg}{t}

\newcommand{\poly}{\mathop{\mathrm{poly}}}

\newcommand{\Amat}[1]{A_{#1}}
\newcommand{\Adet}[1]{\det(\Amat{#1})}

\DeclareMathOperator{\Inv}{Inv}
\DeclareMathOperator{\XInv}{XInv}

\newcommand{\supp}{\mathrm{supp}}

\newcommand{\VanGenSV}[1]{\ensuremath{\mathrm{EVCSV}^{#1}}}
