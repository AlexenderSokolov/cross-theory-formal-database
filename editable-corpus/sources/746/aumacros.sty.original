\ProvidesPackage{aumacros}

\DeclareMathOperator{\expec}{E}
\DeclareMathOperator{\poly}{poly}

\newcommand{\ketbra}[2]{\ket{#1}\!\bra{#2}}

\newcommand{\class}[1]{\ensuremath{\mathsf{#1}}\xspace}
\mathchardef\mhyphen="2D % Define hyphen for complexity classes
\newcommand{\PTIME}{\class{P}}
\newcommand{\BPP}{\class{BPP}}
\newcommand{\NP}{\class{NP}}
\newcommand{\coNP}{\class{coNP}}
\newcommand{\MA}{\class{MA}}
\newcommand{\EXP}{\class{EXP}}
\newcommand{\NEXP}{\class{NEXP}}
\newcommand{\PSPACE}{\class{PSPACE}}
\newcommand{\BQP}{\class{BQP}}
\newcommand{\QCMA}{\class{QCMA}}
\newcommand{\QMA}{\class{QMA}}
%\newcommand{\Pii}[1][i]{\class{\Pi^{p}_{#1}}} %% AU edit2 this was displaying as "^p_2 -->
\newcommand{\Pii}[1][i]{\Pi^{\class{p}}_{\class{#1}}} %% AU edit2 -->
\newcommand{\GapP}{\class{GapP}}
\newcommand{\sharpP}{\class{\#P}}
\newcommand{\PP}{\class{PP}}
\newcommand{\PH}{\class{PH}}
\newcommand{\CH}{\class{CH}}
\newcommand{\CHi}[1][i]{\class{C_{#1}P}}
%\newcommand{\Ppoly}{\class{P\!/\!poly}}
%\newcommand{\BQPpoly}{\class{BQP\!/\!poly}}
%\newcommand{\BQPqpoly}{\class{BQP\!/\!qpoly}}
%\newcommand{\BQPmpoly}{\class{BQP\!/\!mpoly}}
%\newcommand{\BQPQpoly}{\class{BQP\!/\!\textsc{*q}poly}}
%% AU edit2 -->
\newcommand{\Ppoly}{\class{P\!/\hspace{-0.11em}poly}}
\newcommand{\BQPpoly}{\class{BQP\!/\hspace{-0.11em}poly}}
\newcommand{\BQPqpoly}{\class{BQP\!/\hspace{-0.11em}qpoly}}
\newcommand{\BQPmpoly}{\class{BQP\!/\hspace{-0.11em}mpoly}}
\newcommand{\BQPQpoly}{\class{BQP\!/\hspace{-0.11em}\textsc{*q}poly}} 
%% <--
\newcommand{\YQP}{\class{YQP}}
%\newcommand{\YQPpoly}{\class{\YQP\!/\!poly}} %% AU edit2 -->
\newcommand{\YQPpoly}{\class{\YQP\!/\hspace{-0.11em}poly}} %% <--
\newcommand{\YQPstar}{\class{YQP^*}}
%\newcommand{\YQPstarpoly}{\class{\YQP^*\!/\!poly}} %% AU edit2 -->
\newcommand{\YQPstarpoly}{\class{\YQP^*\!/\hspace{-0.11em}poly}} %% <--
\newcommand{\AWPP}{\class{AWPP}}
\newcommand{\APP}{\class{APP}}
\newcommand{\AzeroPP}{\class{A_{0}PP}}
\newcommand{\postBQP}{\class{postBQP}}

\newcommand{\prob}[1]{\textsc{#1}}
\newcommand{\perm}{\prob{Permanent}}

