\ProvidesPackage{yhmath}[2026/10/02 Observed standard wideparen render compatibility]
\newcommand{\jepWideparenAux}[2]{\begingroup\setbox0=\hbox{$#1#2$}\edef\jepParenWidth{\the\wd0}\overset{\resizebox{\jepParenWidth}{0.65ex}{$#1\frown$}}{#2}\endgroup}
\DeclareRobustCommand{\wideparen}[1]{\mathpalette\jepWideparenAux{#1}}
\endinput
