\newcommand\Cases{%
\left\{\!\!\!\begin{array}{ll}\Cases@continue%
}

\def\Cases@continue#1#2{\@ifnextchar\bgroup%
{#1 &\txt{#2}\\ \Cases@continue}%
{#1 &\txt{#2}\end{array}\Cases@end}%
}

\def\Cases@end{\@ifnextchar[%
{\Cases@end@postsq}%
{\right.}
}

\def\Cases@end@postsq[#1]{\ifthenelse{\equal{\}}{#1}}
{\!\!\right\}}%
{\right.}
}

