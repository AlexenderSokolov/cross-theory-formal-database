      "native_aid_active_line": "\\mathcal{S}_\\sotp&=&\\displaystyle \\left[(d_{jk}, [d_{ij},d_{kl}])\\,|\\,(i,j,k,l)\\in \\mathcal{I}_\\sotp \\right]. \\notag"
