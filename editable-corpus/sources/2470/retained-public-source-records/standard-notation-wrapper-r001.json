      "arguments": 0,
      "native_aid_active_line": "\\widetilde{\\mathcal{S}}_\\sotp&=&\\displaystyle \\left[\\,[d_{ij},d_{jk},d_{kl}]\\,|\\,(i,j,k,l)\\in \\mathcal{I}_\\sotp \\right],"
