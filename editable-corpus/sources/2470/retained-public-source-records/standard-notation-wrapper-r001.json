      "native_aid_line": 572,
      "column_1based": 106,
      "literal_call": "\\otp",
      "arguments": 0,
      "native_aid_active_line": "\\widetilde{\\mathcal{S}}_\\otp&=&\\displaystyle \\left[\\,[d_{ij},d_{jk},d_{kl}]\\,|\\,(i,j,k,l)\\in \\mathcal{I}_\\otp \\right]."
