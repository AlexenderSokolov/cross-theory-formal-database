\theoremstyle{definition}
\newtheorem*{rep@definition}{\rep@ref}
\newenvironment{repdefinition}[1]{
 \def\rep@ref{#1}
 \begin{rep@definition}}
 {\end{rep@definition}}
\theoremstyle{plain}
\newtheorem*{restated@theorem}{\rep@title}

\newenvironment{restated}[1]{%
	 \def\rep@title{#1}%
	 \begin{restated@theorem}}%
	{\end{restated@theorem}}
	
\pdfstringdefDisableCommands{%
\let\Cref\crtCref
\let\cref\crtcref
}
