  "problem_id": "932",
  "title": "Closures of higher-rank Voronoi cells for admissible discrete sets decompose into almost-orthogonal scalar Voronoi polyhedra",
  "item_path": "items/932_author_proof.tex",
  "author": "Omid Amini; Noema Nicolussi",
  "work": "Higher rank inner products, Voronoi tilings and metric degenerations of tori",
  "source_id": "doi:10.5802/ahl.257:published-2025",
