  "native_use_inventory": [
    {
      "native_line": 61,
      "exact_line": "\\newcommand{\\vvr}{\\vvmathbb{r}}",
      "vvr_occurrences": 1
    },
    {
      "native_line": 343,
      "exact_line": "Let $T=(V,E)$ be a finite tree with root $\\vvr$ and vertex weights",
      "vvr_occurrences": 1
    },
    {
      "native_line": 451,
      "exact_line": "\\sfK_T &\\seteq \\left\\{ x \\in \\R_+^{V} : x_{\\vvr} = 1,\\ x_u = \\sum_{v \\in \\chi(u)} x_v \\quad \\forall u \\in V \\setminus \\calL\\right\\},",
      "vvr_occurrences": 1
    },
    {
      "native_line": 453,
      "exact_line": "where we use $\\chi(u)$ for the set of children of $u$ in $T$. For $u \\ne\\vvr$, we will also write $\\sfp(u)$ for the parent of $u$ in $T$.",
      "vvr_occurrences": 1
    },
    {
      "native_line": 475,
      "exact_line": "\\Phi_0(x) \\seteq \\frac{1}{\\eta} \\sum_{u \\in V \\setminus \\{\\vvr\\}} w_u \\left(x_u+\\delta_u\\right) \\log \\left(x_u+\\delta_u\\right)\\,,",
      "vvr_occurrences": 1
    },
    {
      "native_line": 490,
      "exact_line": "\\sum_{u\\in V\\setminus\\{\\vvr\\}}",
      "vvr_occurrences": 1
    },
    {
      "native_line": 498,
      "exact_line": "\\sum_{u\\in V\\setminus\\{\\vvr\\}}",
      "vvr_occurrences": 1
    },
    {
      "native_line": 506,
      "exact_line": "\\sum_{u\\in V\\setminus\\{\\vvr\\}}w_u",
      "vvr_occurrences": 1
    },
    {
      "native_line": 524,
      "exact_line": "\\Phi(x) \\seteq \\sum_{u \\in V \\setminus \\{\\vvr\\}} \\frac{w_u}{\\eta_u} \\left(x_u + \\delta_u x_{\\sfp(u)}\\right) \\log \\left(\\frac{x_u}{x_{\\sfp(u)}}+\\delta_u\\right),",
      "vvr_occurrences": 1
    },
    {
      "native_line": 576,
      "exact_line": "$\\{q_u(t) : u \\in V \\setminus \\{\\vvr\\}\\}$:",
      "vvr_occurrences": 1
    },
    {
      "native_line": 674,
      "exact_line": "Let $Q_{T}$ denote the collection of vectors $q \\in \\R_+^{V \\setminus \\{\\vvr\\}}$ such that",
      "vvr_occurrences": 1
    },
    {
      "native_line": 719,
      "exact_line": "We denote $\\alpha = \\alpha^{q,c} \\in \\R_+^{V}$ as the vector given by $\\alpha_v \\seteq \\alpha^{(\\sfp(v))}_v$ for $v \\neq \\vvr$",
      "vvr_occurrences": 1
    },
    {
      "native_line": 720,
      "exact_line": "and $\\alpha_{\\vvr} \\seteq 0$.",
      "vvr_occurrences": 1
    },
    {
      "native_line": 846,
      "exact_line": "\tNoting that $\\hat{c}_{\\vvr} = \\sum_{\\ell \\in \\calL} \\Delta(p)_{\\ell} c_{\\ell}$,  this gives",
      "vvr_occurrences": 1
    },
    {
      "native_line": 848,
      "exact_line": "\t\\tilD(z \\dmid p) - \\tilD(z \\dmid q) \\leq \\sum_{u \\neq \\vvr} (\\hat{c}_u - \\alpha_u) z_u - \\sum_{u \\notin \\calL} z_u \\hat{c}_u",
      "vvr_occurrences": 1
    },
    {
      "native_line": 868,
      "exact_line": "   where $\\psi(x) \\seteq \\sum_{u \\neq \\vvr} w_u x_u$ for $x \\in \\sfK_T$.",
      "vvr_occurrences": 1
    },
    {
      "native_line": 996,
      "exact_line": "\tverifying \\expeqref{inequality}{eq:finemc} with $\\alpha_1 \\leq O(\\kappa(\\depth_T + \\log n))$ and $\\beta' \\leq O(\\kappa \\max_{v \\neq \\vvr} w_v)$ (see \\expref{Lemma}{lem:dmax} below).",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1014,
      "exact_line": "\tIt holds that $\\alpha_v \\leq \\hat{c}_v$ for all $v \\in V \\setminus \\{\\vvr\\}$.",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1042,
      "exact_line": "\\sum_{v \\neq \\vvr} w_v \\left(x_v-y_v\\right)_+ \\leq \\sum_{v \\neq \\vvr} w_v (x_v+\\delta_v x_{\\sfp(v)}) (1-\\eee^{\\sigma_v})_{+} + \\frac{1}{\\tau} \\sum_{v \\neq \\vvr} w_v \\left(x_v-y_v\\right)_+\\,,",
      "vvr_occurrences": 3
    },
    {
      "native_line": 1046,
      "exact_line": "\\sum_{v \\neq \\vvr} w_v \\left(x_v-y_v\\right)_+ &\\leq \\frac{\\tau}{\\tau-1} \\sum_{v \\neq \\vvr} w_v (x_v+\\delta_v x_{\\sfp(v)}) (1-\\eee^{\\sigma_v})_+ \\nonumber \\\\ ",
      "vvr_occurrences": 2
    },
    {
      "native_line": 1047,
      "exact_line": "&\\leq \\frac{\\tau}{\\tau-1} \\sum_{v \\neq \\vvr} w_v (x_v+\\delta_v x_{\\sfp(v)}) \\left(\\sigma_v\\right)_{-} \\nonumber \\\\",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1048,
      "exact_line": "&\\leq\\frac{\\kappa \\tau}{\\tau-1} \\left(\\sum_{v \\neq \\vvr} \\eta_v x_v \\hat{c}_v + \\sum_{u \\notin \\calL} x_u \\sum_{v \\in \\chi(u)} \\theta_v (\\hat{c}_v-\\alpha_v)\\right),",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1057,
      "exact_line": "\\sum_{v \\neq \\vvr} \\eta_v x_v \\hat{c}_v \\leq \\sum_{\\ell \\in \\calL} c_{\\ell} x_{\\ell} \\sum_{v \\in \\gamma_{\\vvr,\\ell} \\setminus \\{\\vvr\\}} \\eta_v",
      "vvr_occurrences": 3
    },
    {
      "native_line": 1062,
      "exact_line": "\\sum_{v \\in \\gamma_{\\vvr,\\ell} \\setminus \\{\\vvr\\}} \\eta_v = \\depth_T(\\ell) + \\sum_{v \\in \\gamma_{\\vvr,\\ell} \\setminus \\{\\vvr\\}} \\log \\frac{|\\calL_{\\sfp(v)}|}{|\\calL_v|} =",
      "vvr_occurrences": 4
    },
    {
      "native_line": 1159,
      "exact_line": "+ \\sum_{v \\neq \\vvr} \\hat{c}_v x_v \\\\",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1214,
      "exact_line": "Fix $u \\neq \\vvr$. ",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1232,
      "exact_line": "We claim that for $u \\neq \\vvr$,",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1239,
      "exact_line": "To verify \\expeqref{equation}{eq:dyn2}, let us define, for $u \\neq \\vvr$,",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1252,
      "exact_line": "\\calE(u) - \\sum_{v \\in \\chi(u)} \\frac{x_v(t)}{x_u(t)} \\calE(v) &= \\beta_{\\sfp(u)}(t) - \\beta_u(t)\\,, && u \\in V \\setminus (\\calL \\cup \\{\\vvr\\}). \\label{eq:egen}",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1257,
      "exact_line": "Let us conclude by verifying \\expeqref{equation}{eq:ass1} for all $u \\notin \\vvr$  by (reverse) induction on the depth.",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1269,
      "exact_line": "We consider a system of variables $\\{q_u(t) : u \\in V \\setminus \\{\\vvr\\}\\}$",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1281,
      "exact_line": "Now the values $q_{\\ell \\mid \\vvr}$ give a probability distribution on the leaves.",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1310,
      "exact_line": "\\left|\\left(q_j\\right)_v - \\left(q_{j-1}\\right)_v\\right| \\leq \\frac{L}{M}, \\quad j \\in \\{1,\\ldots,M\\}, v \\in V \\setminus \\{\\vvr\\}.",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1312,
      "exact_line": "In particular, we see that $q'_{(M)} \\in L^{\\infty}([0,1],\\R^{V \\setminus \\{\\vvr\\}})$ for every $M \\geq 1$ and, moreover,",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1319,
      "exact_line": "Since the unit ball of $L^{\\infty}([0,1], \\R^{V \\setminus \\{\\vvr\\}})$ is weakly compact (by",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1321,
      "exact_line": "$q'_{(M'_k)}$ converges weakly to some $h \\in L^{\\infty}([0,1], \\R^{V \\setminus \\{\\vvr\\}})$.",
      "vvr_occurrences": 1
    },
    {
      "native_line": 1327,
      "exact_line": "If we similarly linearly interpolate the cost function to $\\hat{c}_{(M)} : [0,1] \\to \\R_+^{V \\setminus \\{\\vvr\\}}$,",
      "vvr_occurrences": 1
    }
  ],
