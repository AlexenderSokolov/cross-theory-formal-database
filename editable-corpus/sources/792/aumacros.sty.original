%%% Math Macros %%%
%% Iverson and bag brackets
\usepackage{stmaryrd}

%"vars" for variables
\newcommand{\vars}{\ensuremath{\mathsf{vars}}}
\newcommand{\strikeout}[1]{\hide{#1}}
%\renewcommand{\vec}[1]{\underline{#1}}
\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\norm}[1]{\lVert #1 \rVert}
% set macro
\newcommand{\set}[1]{\{ #1 \}}
% multiset macro
\newcommand{\mset}[1]{\Lbag #1 \Rbag}
% st := such that, used in set builder notation
\newcommand{\st}{\medspace | \medspace}
% true and false
\newcommand{\true}{\mathbf{true}}
\newcommand{\false}{\mathbf{false}}
%% standard number sets (rationals, reals, natural numbers, integers)
\newcommand{\QQ}{\ensuremath{\mathbb{Q}}}
\newcommand{\RR}{\ensuremath{\mathbb{R}}}
\newcommand{\NN}{\ensuremath{\mathbb{N}}}
\newcommand{\ZZ}{\ensuremath{\mathbb{Z}}}
% useful spacing command
\newcommand{\spcnoindent}{\vspace{1em} \noindent}
%% macro for inner products
\newcommand{\inner}[1]{\ensuremath{\langle #1 \rangle}}
% bits
\newcommand{\bits}{\ensuremath{\set{0,1}}}
% always use varepsilon, epsilon is ugly
\renewcommand{\epsilon}{\varepsilon}
%% Math operators, e.g. rank, expectation, variance, probability
\DeclareMathOperator{\rank}{rank}
\DeclareMathOperator*{\Exp}{\mathbb{E}}
\DeclareMathOperator*{\Var}{\mathsf{Var}}
\DeclareMathOperator{\prob}{Pr}
\DeclareMathOperator{\argmax}{argmax}

\renewcommand{\restriction}{\!\!\upharpoonright}


\newcommand{\free}{\ensuremath{\mathrm{free}}}
\newcommand{\fix}{\ensuremath{\mathrm{fix}}}
\newcommand{\boolcube}{\ensuremath{\{0,1\}}}
\newcommand{\depth}{\ensuremath{\mathrm{depth}}}
\newcommand{\Res}{\ensuremath{\mathsf{Res}}}
\newcommand{\tsei}{\ensuremath{\mathsf{Tseitin}}}
\newcommand{\CITE}[1]{{\color{red}(:CITE:#1)}}

%Proof Systems
\newcommand{\SA}{\ensuremath{\mathsf{SA}}}
\newcommand{\LS}{\ensuremath{\mathsf{LS}}}
\newcommand{\PC}{\ensuremath{\mathsf{PC}}}
\newcommand{\RCC}{\ensuremath{\mathsf{RCC}}}
%\newcommand{\Res}{\ensuremath{\mathsf{Res}}}
\newcommand{\tRCP}{\ensuremath{\mathsf{TreeR(CP)}}}
\newcommand{\RCP}{\ensuremath{\mathsf{R(CP)}}}
\newcommand{\pSP}{\ensuremath{\mathsf{pSP}}}

%Formulas
\newcommand{\Tseitin}{\ensuremath{\mathsf{Tseitin}}}
\newcommand{\Unsat}{\ensuremath{\mathsf{Unsat}}}
\newcommand{\XOR}{\ensuremath{\mathsf{XOR}}}
\newcommand{\monCSP}{\ensuremath{\mathsf{mCSP-SAT}}}
\newcommand{\quasipoly}{\ensuremath{\mathsf{quasipoly}}}

%% Removing some negative spaces
\renewcommand{\restriction}{\!\ensuremath{\upharpoonright}\!}
\newcommand{\sCP}{\ensuremath{\mathsf{sCP}}}

\newcommand{\footremember}[2]{%
    \footnote{#2}
    \newcounter{#1}
    \setcounter{#1}{\value{footnote}}%
}
\newcommand{\footrecall}[1]{%
    \footnotemark[\value{#1}]%
} 
