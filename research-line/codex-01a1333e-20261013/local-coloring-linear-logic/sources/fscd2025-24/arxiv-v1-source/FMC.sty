%========== MACHINE

\newcommand\e\varepsilon

\newcommand\evalarrow{\Downarrow}
\newcommand\eval[4][{}]{#2,\,\term{#3}\evalarrow_{#1} #4}

\newcommand\evalRule[2]{%
\begin{array}{@{}c@{}}
	\strut #1
\\\hline
	\strut #2
\end{array}%
}
\newcommandx\evalAlign[8][1={},5={}]{%
\begin{array}{@{}r@{}l@{}}
	\strut #2,\,\term{#3} &{}\evalarrow_{#1} #4
\\\hline
	\strut #6,\,\term{#7} &{}\evalarrow_{#5} #8
\end{array}%
}

\newcommand\dline{\hline\hline\rule[-5pt]{0pt}{15pt}}

\newcommand\step[6]{%
\begin{array}{@{(~}l@{~,~}r@{~,~}r@{~)}}%
         #1 & \term{#2} & #3%
\\\hline #4 & \term{#5} & #6
\end{array}%
}

\newcommand\steps[6]{%
\begin{array}{@{(~}l@{~,~}r@{~,~}r@{~)}}%
         #1 & \term{#2} & #3%
\\\dline #4 & \term{#5} & #6
\end{array}%
}




%========== TYPING RULES

\newcommand\RR[1]{\mathsf{%
  \ifx#1x var\else%
  \ifx#1l abs\else%
  \ifx#1a app\else%
  \ifx#1* unit\else%
  \ifx#1; seq\else%
  \ifx#1c col\else%
  %
  \ifx#1s sub\else%
  %
  \ifx#1e m0\else
  \ifx#1o m1\else%
  \ifx#1i k0\else%
  \ifx#1k k1\else%
  \ifx#1? st\else%
  %
  \ifx#1A APP\else%
  \ifx#1W WEAK\else%
  \ifx#1O M1\else%
  \ifx#1S APPS\else
  %
  \fi\fi\fi\fi\fi\fi%
  \fi%
  \fi\fi\fi\fi\fi%
  \fi\fi\fi\fi%
}}

\newcommand\rr[1]{\!\!\scriptstyle{\RR{#1}}}


