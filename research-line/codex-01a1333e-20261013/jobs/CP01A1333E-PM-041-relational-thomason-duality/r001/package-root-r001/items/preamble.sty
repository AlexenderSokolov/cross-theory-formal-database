\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}[2026/04/30 Custom macros for Relational Dualities and Bisimulation]

\RequirePackage{tikz}
\usetikzlibrary{cd}
\RequirePackage{xcolor}

\NewDocumentCommand{\red}{m}{\textcolor{red}{{#1}}}

\RequirePackage{amsmath, amssymb, mathtools, mathpartir}

\RequirePackage{lattices,categories}

\NewDocumentCommand{\adjoint}{}{\ensuremath{\dashv}}
\NewDocumentCommand{\Rel}{sm}{
  \mathbin{\IfBooleanTF{#1}{\DelimPrn{#2}}{#2}}
}
\NewDocumentCommand{\then}{}{\mathbin{;}}
\NewDocumentCommand{\Rev}{m}{{#1}^\dagger}
\NewDocumentCommand{\Relcomp}{m}{\ensuremath{\mathbin{\Par{#1}}}}
\NewDocumentCommand{\relto}{}{\relbar\joinrel\mapstochar\joinrel\rightarrow} % taken from Alex
\NewDocumentCommand{\Par}{m}{\ensuremath{\left(#1\right)}}
\NewDocumentCommand{\Set}{m}{\ensuremath{\left\{#1\right\}}}
\NewDocumentCommand{\SetComp}{mm}{\ensuremath{\Set{#1 \mid #2}}}
\NewDocumentCommand{\atom}{}{\ensuremath{\text{atom~}}}
\NewDocumentCommand{\Lower}{g}{
  \mathbin{\mathfrak{L}\IfNoValueTF{#1}{}{\DelimPrn{#1}}}
}
\NewDocumentCommand{\Upper}{g}{
  \mathbin{\mathfrak{U}\IfNoValueTF{#1}{}{\DelimPrn{#1}}}
}
\NewDocumentCommand{\Variant}{m}{\Rel{{#1}^\bullet}}

\NewDocumentCommand{\Powerset}{sg}{
  \mathcal{P}\IfNoValueTF{#2}{}{
    \IfBooleanTF{#1}{\DelimPrn{#2}}{#2}
  }
}
\NewDocumentCommand{\At}{g}{
  \textsf{At}\IfNoValueTF{#1}{}{\DelimPrn{#1}}
}
\NewDocumentCommand{\Gr}{m}{\ensuremath{\mathbin{\text{Gr}\Par{#1}}}}
\NewDocumentCommand{\Graph}{g}{
  \mathbin{\textrm{Gr}\IfNoValueTF{#1}{}{\Par{#1}}}
}
\NewDocumentCommand{\defeq}{}{\stackrel{\mathclap{\mbox{\tiny def}}}{=}} % ditto
\NewDocumentCommand{\defequiv}{}{\stackrel{\mathclap{\mbox{\tiny def}}}{\equiv}} % ditto

\newcommand{\op}{\ensuremath{^{\mathrm{op}}}}
\NewDocumentCommand{\FRM}{}{\mathbf{Frm}}
\NewDocumentCommand{\FRMOPEN}{}{\mathbf{Frm}_{\mathrm{open}}}
\NewDocumentCommand{\FRMSIM}{}{\ensuremath{\mathbf{FrmSim}}}
\NewDocumentCommand{\FRMBISIM}{}{\ensuremath{\mathbf{FrmBisim}}}
\NewDocumentCommand{\CABAJoin}{}{\CABA_{\smash\bigvee}}
\NewDocumentCommand{\BOOL}{}{\mathbf{Bool}}    % Boolean algs
\NewDocumentCommand{\CABA}{}{\mathbf{CABA}}    % Complete atomic Boolean algs
\NewDocumentCommand{\CABAOW}{}{\mathbf{CABAO}^{-}}  % Complete atomic Boolean algs with ops
\NewDocumentCommand{\CABAO}{}{\mathbf{CABAO}}
\NewDocumentCommand{\CABAOSIM}{}{\mathbf{CABAOSim}}
\NewDocumentCommand{\CABAOBISIM}{}{\mathbf{CABAOBisim}}
\NewDocumentCommand{\REL}{}{\mathbf{Rel}}
\NewDocumentCommand{\CABAREL}{}{\mathbf{CABARel}}

\NewDocumentCommand{\Transition}{m}{\to_{#1}}
\NewDocumentCommand{\Simulates}{mmm}{
  #1
  \overset{{\scriptscriptstyle #2}}{\searrow}
  #3
}

\endinput
