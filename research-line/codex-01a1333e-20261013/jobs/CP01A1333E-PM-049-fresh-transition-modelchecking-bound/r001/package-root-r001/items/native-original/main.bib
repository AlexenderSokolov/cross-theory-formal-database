@article{Kozen83,
title = {Results on the propositional $\mu$-calculus},
journal = {Theoretical Computer Science},
volume = {27},
number = {3},
pages = {333-354},
year = {1983},
note = {Special Issue Ninth International Colloquium on Automata, Languages and Programming (ICALP) Aarhus, Summer 1982},
