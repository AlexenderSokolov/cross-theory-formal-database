@article{edelsbrunnerIncrementalTopologicalFlipping1996,
  title = {Incremental Topological Flipping Works for Regular Triangulations},
  author = {Edelsbrunner, Herbert and Shah, Nimish R.},
  year = {1996},
  journal = {Algorithmica},
  volume = {15},
  number = {3},
  pages = {223--241},
  abstract = {A set of n weighted points in general position in Na defines a unique regular triangulation. This paper proves that if the points are added one by one, then flipping in a topological order will succeed in constructing this triangulation. If, in addition, the points are added in a random sequence and the history of the flips is used for locating the next point, then the algorithm takes expected time at most O (n log n + n ra/2] ). Under the assumption that the points and weights are independently and identically distributed, the expected running time is between proportional to and a factor log n more than the expected size of the regular triangulation. The expectation is over choosing the points and over independent coin-flips performed by the algorithm.},
  langid = {english},
  file = {/home/ajalonso/Zotero/storage/GPGR3XKY/Edelsbrunnera and Shah - Incremental topological flipping works for regular.pdf}
}

@article{reaniCoupledAlphaComplex2023,
  title = {A Coupled Alpha Complex},
  author = {Reani, Yohai and Bobrowski, Omer},
  year = {2023},
  month = oct,
  journal = {Journal of Computational Geometry},
  volume = {14},
  number = {1},
  pages = {221--256},
  issn = {1920-180X},
  abstract = {The alpha complex is a subset of the Delaunay triangulation and is often used in computational geometry and topology. One of the main drawbacks of using the alpha complex is that it is non-monotone, in the sense that if \$\{{\textbackslash}cal X\}{\textbackslash}subset\{{\textbackslash}cal X\}'\$ it is not necessarily (and generically not) the case that the corresponding alpha complexes satisfy \$\{{\textbackslash}cal A\}\_r(\{{\textbackslash}cal X\}){\textbackslash}subset\{{\textbackslash}cal A\}\_r(\{{\textbackslash}cal X\}')\$. The lack of monotonicity may introduce significant computational costs when using the alpha complex, and in some cases even render it unusable. In this work we present a new construction based on the alpha complex, that is homotopy equivalent to the alpha complex while maintaining monotonicity. We provide the formal definitions and algorithms required to construct this complex. In addition, we analyze the size of this complex in order to argue that it is not significantly more costly to use than the standard alpha complex.},
  copyright = {Copyright (c) 2023 Yohai Reani, Omer Bobrowski},
  langid = {english},
  file = {/home/ajalonso/Zotero/storage/RLJNFMYV/Reani and Bobrowski - 2023 - A coupled alpha complex.pdf}
}

