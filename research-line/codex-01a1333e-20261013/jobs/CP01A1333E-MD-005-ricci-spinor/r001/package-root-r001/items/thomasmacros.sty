%-- definition of mappings
% ======================================================================================
\newcommand{\mapdef}[5]{%
	\[
	\begin{array}{lrcl}
	\textstyle #1\colon&\textstyle #2 &\xrightarrow{\minwidthbox{ }{2em}} & \textstyle #3 \\[0.5ex]
	&\textstyle #3 &\xmapsto{\minwidthbox{\mbox{ }}{2em}} & \textstyle #4
	\end{array}
	\]
}
\newcommand{\mapdefoneline}[5]{%
	\[
	\textstyle #1\colon \textstyle #2 \xrightarrow{\minwidthbox{ }{1em}} \textstyle #3, \;
	\textstyle #4 \xmapsto{\minwidthbox{\mbox{ }}{1em}} \textstyle #5
	\]
}
\newcommand{\mapdefonelinenoname}[4]{%
	\[
	\textstyle #1 \xrightarrow{\minwidthbox{ }{1em}} \textstyle #2, \;
	\textstyle #3 \xmapsto{\minwidthbox{\mbox{ }}{1em}} \textstyle #4
	\]
}
\newcommand{\To}[1]{\xrightarrow{\minwidthbox{#1}{2em}}} % has the same length as \mapdef 
\newcommand{\Mapsto}{\xmapsto{\minwidthbox{\mbox{ }}{1em}}} % has the same length as \mapdef

