@article{aichholzerBicoloredOrderTypes2024,
  title = {Bicolored {{Order Types}}},
  author = {Aichholzer, Oswin and Br{\"o}tzner, Anna},
  year = 2024,
  month = jan,
  journal = {Computing in Geometry and Topology},
  volume = {3},
  number = {2},
  pages = {3:1-3:17},
  issn = {2750-7823},
  doi = {10.57717/cgt.v3i2.46},
  urldate = {2025-11-14},
  abstract = {In their seminal work on Multidimensional Sorting, Goodman and Pollack introduced the so-called order type, which for each ordered triple of a point set in the plane gives its orientation, clockwise or counterclockwise. This information is sufficient to solve many problems from discrete geometry where properties of point sets do not depend on the exact coordinates of the points but only on their relative positions. Goodman and Pollack showed that an efficient way to store an order type in a matrix {$\lambda$} of quadratic size (w.r.t. the number of points) is to count for every oriented line spanned by two points of the set how many of the remaining points lie to the left of this line.We generalize the concept of order types to bicolored point sets (every point has one of two colors). The bicolored order type contains the orientation of each bicolored triple of points, while no information is stored for monochromatic triples. Similar to the uncolored case, we store the number of blue points that are to the left of an oriented line spanned by two red points or by one red and one blue point in {$\lambda$}B . Analogously the number of red points is stored in {$\lambda$}R . As a main result, we show that the equivalence of the information contained in the orientation of all bicolored point triples and the two matrices {$\lambda$}B and {$\lambda$}R also holds in the colored case. This is remarkable, as in general the bicolored order type does not even contain sufficient information to determine all extreme points (points on the boundary of the convex hull of the point set).We then show that the information of a bicolored order type is sufficient to determine whether the two color classes can be linearly separated and how one color class can be sorted around a point of the other color class. Moreover, knowing the bicolored order type of a point set suffices to find bicolored plane perfect matchings or to compute the number of crossings of the complete bipartite graph drawn on a bicolored point set in quadratic time.},
  copyright = {Copyright (c) 2023 Oswin Aichholzer, Anna Br\"otzner},
  langid = {english}
}



@misc{hoffmannUniversalityTheoremAllowable2018,
  title = {A Universality Theorem for Allowable Sequences with Applications},
  author = {Hoffmann, Udo and Merckx, Keno},
  year = 2018,
  month = jan,
  number = {arXiv:1801.05992},
  eprint = {1801.05992},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1801.05992},
  urldate = {2025-11-13},
  abstract = {Order types are a well known abstraction of combinatorial properties of a point set. By Mn\"ev's universality theorem for each semi-algebraic set \$V\$ there is an order type with a realization space that is \textbackslash emph\textbraceleft stably equivalent\textbraceright{} to \$V\$. We consider realization spaces of \textbackslash emph\textbraceleft allowable sequences\textbraceright, a refinement of order types. We show that the realization spaces of allowable sequences are \textbackslash emph\textbraceleft universal\textbraceright{} and consequently deciding the realizability is complete in the \textbackslash emph\textbraceleft existential theory of the reals\textbraceright{} (\textbackslash ER). This result holds even if the realization space of the order type induced by the allowable sequence is non-empty. Furthermore, we argue that our result is a useful tool for further geometric reductions. We support this by giving \textbackslash ER-hardness proofs for the realizability of abstract convex geometries and for the recognition problem of visibility graphs of polygons with holes using the hardness result for allowable sequences. This solves two longstanding open problems.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computational Geometry}
}


@article{ericksonSmoothingGapNP2024,
  title = {Smoothing the {{Gap Between NP}} and {{ER}}},
  author = {Erickson, Jeff and {van der Hoog}, Ivor and Miltzow, Tillmann},
  year = 2024,
  month = dec,
  journal = {SIAM Journal on Computing},
  volume = {53},
  number = {6},
  pages = {FOCS20-102},
  publisher = {{Society for Industrial and Applied Mathematics}},
  issn = {0097-5397},
  doi = {10.1137/20M1385287},
  urldate = {2025-11-13},
  abstract = {This paper defines and studies a computational model (a random access machine with powerful input/output instructions), and shows that the classes \$\textbraceleft\textbackslash text\textbraceleft DLINEAR\textbraceright\textbraceright\$ and \$\textbraceleft\textbackslash text\textbraceleft NLINEAR\textbraceright\textbraceright\$ of problems computable in deterministic (respectively, nondeterministic) linear time in this model of computation are robust and powerful. In particular, \$\textbraceleft\textbackslash text\textbraceleft DLINEAR\textbraceright\textbraceright\$ includes most of the concrete problems commonly regarded as computable in linear time (such as graph problems, topological sorting, strong connectivity, etc.). Most combinatorial NP-complete problems are in \$\textbraceleft\textbackslash text\textbraceleft NLINEAR\textbraceright\textbraceright\$. The interest of \$\textbraceleft\textbackslash text\textbraceleft NLINEAR\textbraceright\textbraceright\$ class is enhanced by the fact that some natural NP-complete problems, for example, ``reduction of incompletely specified automata'' \$(\textbraceleft\textbackslash text\textbraceleft RISA\textbraceright\textbraceright )\$, are \$\textbraceleft\textbackslash text\textbraceleft NLINEAR\textbraceright\textbraceright\$-complete (consequently, \$\textbraceleft\textbackslash text\textbraceleft NLINEAR\textbraceright\textbraceright{} \textbackslash ne \textbraceleft\textbackslash text\textbraceleft{} DLINEAR\textbraceright\textbraceright\$ if and only if \$\textbraceleft\textbackslash text\textbraceleft RISA\textbraceright\textbraceright{} \textbackslash notin \textbraceleft\textbackslash text\textbraceleft DLINEAR\textbraceright\textbraceright\$). This notion strengthens NP-completeness, as this paper argues that propositional satisfiability is not \$\textbraceleft\textbackslash text\textbraceleft NLINEAR\textbraceright\textbraceright\$ complete.}
}


