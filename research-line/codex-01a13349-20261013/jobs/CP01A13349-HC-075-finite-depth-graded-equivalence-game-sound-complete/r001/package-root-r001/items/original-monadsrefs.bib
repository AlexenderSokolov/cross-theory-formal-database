@inproceedings{bp:checking-nfa-equiv,
author = {Filippo Bonchi and 
               Damien Pous},
title = {Checking NFA Equivalence with Bisimulations up to Congruence},
year = {2013},
noisbn = {9781450318327},
publisher = {ACM},
noaddress = {New York, NY, USA},
nourl = {https://doi.org/10.1145/2429069.2429124},
doi = {10.1145/2429069.2429124},
noabstract = {We introduce bisimulation up to congruence as a technique for proving language equivalence of non-deterministic finite automata. Exploiting this technique, we devise an optimisation of the classical algorithm by Hopcroft and Karp. We compare our approach to the recently introduced antichain algorithms, by analysing and relating the two underlying coinductive proof methods. We give concrete examples where we exponentially improve over antichains; experimental results moreover show non negligible improvements.},
booktitle = {Principles of Programming Languages, POPL 2013},
pages = {457–468},
nonumpages = {12},
nokeywords = {bisimulation, coinduction, congruence, antichain, language equivalence, automata, up-to techniques},
nolocation = {Rome, Italy}
}





