@article{Lack99,
title = "On the monadicity of finitary monads",
journal = "J.\ Pure Appl.\ Algebra",
volume = "140",
number = "1",
pages = "65--73",
year = "1999",
noissn = "0022-4049",
doi = "https://doi.org/10.1016/S0022-4049(99)00019-5",
nourl = "http://www.sciencedirect.com/science/article/pii/S0022404999000195",
author = "Steve Lack",
noabstract = "In 1993, Kelly and Power showed that the category of finitary monads on a locally finitely presentable category A is of descent type over a power of A; here we establish the stronger result that the forgetful functor in question is monadic. Both their result and ours remain true in the V-enriched case for suitable monoidal categories V. Generalizing further, we obtain a monadicity result for algebras for an operad."
}


