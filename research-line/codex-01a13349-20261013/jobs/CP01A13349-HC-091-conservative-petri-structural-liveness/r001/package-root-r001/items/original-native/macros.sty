\newcommand*{\lastx}{}
\newcommand*{\lasty}{}
\newcommand{\drawconf}[5]{
    \xdef\lastx{#5}
    \foreach \y[count=\i] in {#3} {
        \ifnum \i = 1
            \draw[#1, #2] (\lastx,\y) -- (\lastx+#4,\y);
        \fi
        \ifnum \i > 1
            \draw[#1, #2] (\lastx,\lasty) -- (\lastx,\y);
            \draw[#1, #2] (\lastx,\y) -- (\lastx+#4,\y);
        \fi
        \xdef\lastx{\lastx+#4}
        \xdef\lasty{\y}
    }
}

