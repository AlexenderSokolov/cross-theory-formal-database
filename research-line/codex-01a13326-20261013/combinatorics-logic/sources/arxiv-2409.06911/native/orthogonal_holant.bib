@article{huang_diagonalizable_2021,
  title = {Diagonalizable higher degree forms and symmetric tensors},
  volume = {613},
  doi = {10.1016/j.laa.2020.12.018},
  abstract = {We provide simple criteria and algorithms for expressing homogeneous polynomials as sums of powers of independent linear forms, or equivalently, for decomposing symmetric tensors into sums of rank-1 symmetric tensors of linearly independent vectors. The criteria rely on two facets of higher degree forms, namely Harrison's algebraic theory and some algebro-geometric properties. The proposed algorithms are based purely on solving linear and quadratic equations. Moreover, as a byproduct of our criteria and algorithms one can easily decide whether or not a homogeneous polynomial or symmetric tensor is orthogonally or unitarily decomposable.},
  journal = {Linear Algebra and its Applications},
  author = {Huang, Hua-Lin and Lu, Huajun and Ye, Yu and Zhang, Chi},
  month = {mar},
