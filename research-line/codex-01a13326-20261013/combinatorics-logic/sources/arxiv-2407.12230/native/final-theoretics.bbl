      \verb https://doi.org/10.1145/3672562
      \endverb
      \verb{url}
      \verb https://doi.org/10.1145/3672562
      \endverb
      \keyw{Scattering partition,sparse partition,{Steiner} point removal,universal {TSP},universal {Steiner} tree}
    \endentry
