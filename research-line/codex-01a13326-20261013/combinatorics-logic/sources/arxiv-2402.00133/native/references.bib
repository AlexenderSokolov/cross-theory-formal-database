pages = {145-153},
year = {1983},
issn = {0097-3165},
doi = {10.1016/0097-3165(83)90003-1},
author = {Jerrold R Griggs},
abstract = {Ajtai, Komlós, and Szemerédi (J. Combin. Theory Ser. A 29 (1980), 354–360) recently announced that R(3, k) < 100k2ln k. This follows from the discovery of a (polynomial) algorithm to find in any triangle-free graph on n vertices with average degree t an independent set of size at least n ln t100t. Here, their algorithm is modified to improve both bounds, replacing 100 by 2.4, and carefully working out the details of the proof.}
