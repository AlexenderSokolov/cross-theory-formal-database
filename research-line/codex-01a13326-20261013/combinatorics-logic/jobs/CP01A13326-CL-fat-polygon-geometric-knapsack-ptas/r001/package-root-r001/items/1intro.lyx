\begin_layout Standard
In a recent paper, Abhrahamsen, Miltzow, and Seiferth
\begin_inset space ~
\end_inset


\begin_inset CommandInset citation
LatexCommand cite
key "abrahamsen2020framework"
literal "false"

\end_inset

