@inbook{LV21,
author = {Li, Wenzheng and Vondr\'{a}k, Jan},
title = {Estimating the {N}ash social welfare for coverage and other submodular valuations},
year = {2021},
isbn = {9781611976465}, 
abstract = {We study the {N}ash Social Welfare problem: Given n agents with valuation functions vi : 2[m] → R+, partition [m] into S1, …, Sn so as to maximize [EQUATION]. The problem has been shown to admit a constant-factor approximation for additive, budget-additive, and piecewise linear concave separable valuations; the case of submodular valuations is open.We provide a [EQUATION]-approximation of the optimal value for several classes of submodular valuations: coverage, sums of matroid rank functions, and certain matching-based valuations.},
booktitle = {Proceedings of the Thirty-Second Annual ACM-SIAM Symposium on Discrete Algorithms},
pages = {1119–1130},
numpages = {12}, 
series = {SODA '21},
doi = {10.1137/1.9781611976465.69},
}




