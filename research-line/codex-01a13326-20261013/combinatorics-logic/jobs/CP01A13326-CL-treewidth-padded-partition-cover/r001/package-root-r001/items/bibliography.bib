@incollection{Ber78,
title = {Hamiltonian Decompositions of Graphs, Directed Graphs and Hypergraphs},
editor = {B. Bollobás},
series = {Annals of Discrete Mathematics},
publisher = {Elsevier},
volume = {3},
pages = {21-28},
year = {1978},
booktitle = {Advances in Graph Theory},
issn = {0167-5060},
doi = {https://doi.org/10.1016/S0167-5060(08)70494-1},
url = {https://www.sciencedirect.com/science/article/pii/S0167506008704941},
author = {J.-C. Bermond},
abstract = {Publisher Summary
Graph G (undirected or directed) can be decomposed into Hamiltonian cycles or paths if one can partition its edges (arcs in the directed case) into Hamiltonian cycles or paths (directed cycles or directed paths in the directed case). This chapter focuses on the Hamiltonian decompositions of graphs, directed graphs, and hypergraphs. Several problems related to these graphs are discussed. Directed graphs are more difficult than the Hamiltonian decompositions of graphs. Many of the known results are obtained in the following easy way; associate with a Hamiltonian decomposition of G a Hamiltonian decomposition of the directed graph G* (obtained from G by associating to each edge of G two opposite arcs) by associating with each Hamiltonian cycle two opposite directed Hamiltonian cycles. For hypergraphs, the number of problems grows quickly, because different definitions of a Hamiltonian cycle can be given.}
}

