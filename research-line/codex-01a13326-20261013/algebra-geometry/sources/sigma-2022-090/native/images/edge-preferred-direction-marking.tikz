\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-1, 0) {};
		\node [style=none] (1) at (0.25, 0) {};
		\node [style=none] (2) at (0, 0.25) {};
		\node [style=none] (3) at (0, -0.25) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=thick black] (0.center) to (1.center);
		\draw [style=very thick blue] (2.center) to (3.center);
	\end{pgfonlayer}
\end{tikzpicture}
