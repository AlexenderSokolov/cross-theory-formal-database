\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=bullet] (1) at (-5, 0) {$4$};
		\node [style=bullet] (2) at (-3, 0) {$3$};
		\node [style=bullet] (3) at (-1, 0) {$2$};
		\node [style=bullet] (4) at (0.5, 1.5) {$5$};
		\node [style=bullet] (5) at (0.5, -1.5) {$1$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (2) to (1);
		\draw (3) to (2);
		\draw (3) to (4);
		\draw (3) to (5);
	\end{pgfonlayer}
\end{tikzpicture}
