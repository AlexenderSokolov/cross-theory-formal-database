%Resize Delimeter based on content
\makeatletter
\newcommand*{\@trimleftright}[4]{%
  % #1: left fence
  % #2: right fence
  % #3: math style
  % #4: formula
  \sbox0{$#3#4\m@th$}%
  \sbox2{$#3\vcenter{}$}% Math axis: \ht2
  \sbox4{$#3\left#1\right#2$}%
  % \dimen0: min(height(formula), math axis)
  \dimen0=\dimexpr\ht0\relax %
  \ifdim\dimen0<\ht2 %
    \dimen0=\ht2 %
  \fi
  % \dimen2: min(depth(formula), 0)
  \dimen2=\dp0 %
  \ifdim\dimen2<\z@
    \dimen2=\z@
  \fi
  % Make formula as least as tall as the fences without content.
  \ifdim\ht4>\dimen0 %
    \dimen0=\ht4 %
  \fi
  \ifdim\dp4>\dimen2 %
    \dimen2=\dimexpr\dp4\relax %
  \fi
  % \dimen0: vertical shift for centering
  \dimen0=\dimexpr(\dimen0-\dimen2)/2 -\ht2\relax
  \raisebox{\dimen0}{%
    $#3\left#1\raisebox{-\dimen0}{\box0}\right#2\m@th$%
  }%
}
\makeatother
