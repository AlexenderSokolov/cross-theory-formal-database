%Absolute value
\makeatletter
\def\abs#1{\ifx\relax#1\relax\empty|\emptyarg|\else
    {\mathchoice%
        {\left\lvert #1\right \rvert}%
        {\lvert #1\rvert}%
        {\@trimleftright{\lvert}{\rvert}{\scriptstyle}{#1}}%
        {\@trimleftright{\lvert}{\rvert}{\scriptscriptstyle}{#1}}}%
        \fi%
}
\makeatother

\makeatletter
\def\snorm#1{\ifx\relax#1\relax\empty[\emptyarg]\else
    {\mathchoice%
        {\@trimleftright{[}{]}{\displaystyle}{#1}}%
        {[#1]}%
        {\@trimleftright{[}{]}{\scriptstyle}{#1}}%
        {\@trimleftright{[}{]}{\scriptscriptstyle}{#1}}}%
        \fi%
}
\makeatother

% Norma
\makeatletter
\DeclarePairedDelimiter{\@set}{\lbrace}{\rbrace}
\def\set#1{\def\st{\,\middle\vert\,}\ifx\relax#1\relax\empty\varnothing\else\@set*{#1}\fi}
\makeatother

% Norma
\makeatletter
\DeclarePairedDelimiter{\@norm}{\lVert}{\rVert}
\def\norm#1{\ifx\relax#1\relax\empty{\@norm*{\emptyarg}}\else{\@norm*{#1}}\fi}
\makeatother

% Prodotto interno
\makeatletter

\def\ip#1{\ifx\relax#1\relax\empty\langle\,\emptyarg\,,\,\emptyarg\,\rangle\else\@ip#1\relax\fi}
\def\@ip#1|#2\relax{{\mathchoice%
        {\left\langle{\ifx\relax#1\relax\empty\,\emptyarg\,\else #1\,\fi}\middle\vert{\ifx\relax#2\relax\empty\,\emptyarg\,\else\,#2\fi}\right\rangle}%
        {\langle{\ifx\relax#1\relax\empty\,\emptyarg\,\else #1\,\fi}\vert{\ifx\relax#2\relax\empty\,\emptyarg\,\else\,#2\fi}\rangle}%
        {\scriptstyle\langle{\ifx\relax#1\relax\empty\,\emptyarg\,\else #1\,\fi}\vert{\ifx\relax#2\relax\empty\,\emptyarg\,\else\,#2\fi}\rangle}%
        {\scriptscriptstyle\langle{\ifx\relax#1\relax\empty\,\emptyarg\,\else #1\,\fi}\vert{\ifx\relax#2\relax\empty\,\emptyarg\,\else\,#2\fi}\rangle}}}
\makeatother

