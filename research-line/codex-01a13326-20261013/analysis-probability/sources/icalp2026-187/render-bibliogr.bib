@article{SUNILCHANDRAN2006359,
	title = {The treewidth and pathwidth of hypercubes},
	journal = {Discrete Mathematics},
	volume = {306},
	number = {3},
	pages = {359-365},
	year = {2006},
	note = {Minimal Separation and Minimal Triangulation},
	issn = {0012-365X},
	doi = {https://doi.org/10.1016/j.disc.2005.12.011},
	url = {https://www.sciencedirect.com/science/article/pii/S0012365X05006102},
	author = {L. {Sunil Chandran} and T. Kavitha},
	keywords = {Treewidth, Pathwidth, Hypercube, Hamming graph},
	abstract = {The d-dimensional hypercube, Hd, is the graph on 2d vertices, which correspond to the 2d d-vectors whose components are either 0 or 1, two of the vertices being adjacent when they differ in just one coordinate. The notion of Hamming graphs (denoted by Kqd) generalizes the notion of hypercubes: The vertices correspond to the qd d-vectors where the components are from the set {0,1,2,…,q-1}, and two of the vertices are adjacent if and only if the corresponding vectors differ in exactly one component. In this paper we show that the pw(Hd)=∑m=0d-1mm2 and the tw(Kqd)=θ(qd/d).}
}

