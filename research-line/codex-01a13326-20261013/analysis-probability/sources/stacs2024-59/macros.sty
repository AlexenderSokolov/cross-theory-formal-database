\newcommand{\marklen}{3pt}
\newcommand{\marksep}{2.5pt}

\definecolor{customred}{HTML}{EE204E}

\tikzset{
  horizontal center at origin/.style={
    execute at end picture={
      \path let \p1=(current bounding box.west),\p2=(current bounding box.east)
      in ({-max(-1*\x1,\x2)},\y1) ({max(-1*\x1,\x2)},\y1);
    }
  },
  nontriv/.style={decorate,
    decoration={zigzag, segment length=1.5mm, amplitude=0.5mm,
      pre=lineto, pre length=(\pgfmetadecoratedpathlength - 17.5pt), post=lineto, post length=5pt}
  },
  two-marks/.style={
    postaction={decorate,
      decoration={
        markings,
        mark=at position 0.5*\pgfdecoratedpathlength-#1 with {
          \begin{scope}[xslant=0.2]
            \draw[line width=\marksep, white, -] (0pt, -\marklen) -- (0pt, \marklen);
            \draw[-] (-0.5*\marksep, -\marklen) -- (-0.5*\marksep, \marklen);
            \draw[-] (0.5*\marksep, -\marklen) -- (0.5*\marksep, \marklen);
          \end{scope}
        }
      }
    }
  },
  new/.style={customred},
  simulates/.style={->, >=Stealth},
  simulates-nontriv/.style={->, >=Stealth,
    decorate, decoration={zigzag, segment length=1.5mm, amplitude=0.5mm,
      pre=lineto, pre length=(\pgfmetadecoratedpathlength - 12pt), post=lineto, post length=5pt}},
  equivalent/.style={<->, >=Stealth},
  stronger/.style={->, >=Stealth, two-marks=0pt},
  stronger-short/.style={->, >=Stealth, two-marks=0.8pt},
  separated/.style={->, >=Circle, dashed},
  incomparable/.style={<->, >=Circle, dashed},
  overdraw/.style={preaction={draw=white, double=white, double distance=3.75pt}},
}

\newcommand{\makerel}[1]{%
  \mathrel{%
    \begin{tikzpicture}[baseline=-\the\dimexpr\fontdimen22\textfont2\relax]%
      \draw[style=#1] (0, 0) -- (1.75em, 0);%
    \end{tikzpicture}%
  }%
}

\DeclareRobustCommand{\simulates}{\makerel{simulates}}
\DeclareRobustCommand{\ntsimulates}{\makerel{simulates-nontriv}}
\DeclareRobustCommand{\equivalent}{\makerel{equivalent}}
\DeclareRobustCommand{\stronger}{\makerel{stronger-short}}
\DeclareRobustCommand{\separated}{\makerel{separated}}
\DeclareRobustCommand{\incomparable}{\makerel{incomparable}}
