@misc{reis_linear_2019,
	title = {Linear {Size} {Sparsifier} and the {Geometry} of the {Operator} {Norm} {Ball}},
	url = {http://arxiv.org/abs/1907.02145},
	abstract = {The Matrix Spencer Conjecture asks whether given \$n\$ symmetric matrices in \${\textbackslash}mathbb\{R\}{\textasciicircum}\{n {\textbackslash}times n\}\$ with eigenvalues in \$[-1,1]\$ one can always find signs so that their signed sum has singular values bounded by \$O({\textbackslash}sqrt\{n\})\$. The standard approach in discrepancy requires proving that the convex body of all good fractional signings is large enough. However, this question has remained wide open due to the lack of tools to certify measure lower bounds for rather small non-polyhedral convex sets. A seminal result by Batson, Spielman and Srivastava from 2008 shows that any undirected graph admits a linear size spectral sparsifier. Again, one can define a convex body of all good fractional signings. We can indeed prove that this body is close to most of the Gaussian measure. This implies that a discrepancy algorithm by the second author can be used to sample a linear size sparsifer. In contrast to previous methods, we require only a logarithmic number of sampling phases.},
	urldate = {2023-12-19},
	publisher = {arXiv},
	author = {Reis, Victor and Rothvoss, Thomas},
	month = oct,
	year = {2019},
	note = {arXiv:1907.02145 [cs]},
	keywords = {Computer Science - Data Structures and Algorithms, Computer Science - Discrete Mathematics},
}

@misc{hendrey_finding_2023,
	title = {Finding dense minors using average degree},
	url = {http://arxiv.org/abs/2307.01184},
	abstract = {Motivated by Hadwiger's conjecture, we study the problem of finding the densest possible \$t\$-vertex minor in graphs of average degree at least \$t-1\$. We show that if \$G\$ has average degree at least \$t-1\$, it contains a minor on \$t\$ vertices with at least \$({\textbackslash}sqrt\{2\}-1-o(1)){\textbackslash}binom\{t\}\{2\}\$ edges. We show that this cannot be improved beyond \${\textbackslash}left({\textbackslash}frac\{3\}\{4\}+o(1){\textbackslash}right){\textbackslash}binom\{t\}\{2\}\$. Finally, for \$t{\textbackslash}leq 6\$ we exactly determine the number of edges we are guaranteed to find in the densest \$t\$-vertex minor in graphs of average degree at least \$t-1\$.},
	language = {en},
	urldate = {2023-12-16},
	publisher = {arXiv},
	author = {Hendrey, Kevin and Norin, Sergey and Steiner, Raphael and Turcotte, Jérémie},
	month = jul,
	year = {2023},
