@article{conlon_approximate_2010,
	title = {An {Approximate} {Version} of {Sidorenko}’s {Conjecture}},
	volume = {20},
	issn = {1016-443X, 1420-8970},
	url = {http://link.springer.com/10.1007/s00039-010-0097-0},
	doi = {10.1007/s00039-010-0097-0},
	abstract = {A beautiful conjecture of Erd˝os–Simonovits and Sidorenko states that, if H is a bipartite graph, then the random graph with edge density p has in expectation asymptotically the minimum number of copies of H over all graphs of the same order and edge density. This conjecture also has an equivalent analytic form and has connections to a broad range of topics, such as matrix theory, Markov chains, graph limits, and quasirandomness. Here we prove the conjecture if H has a vertex complete to the other part, and deduce an approximate version of the conjecture for all H. Furthermore, for a large class of bipartite graphs, we prove a stronger stability result which answers a question of Chung, Graham, and Wilson on quasirandomness for these graphs.},
	language = {en},
	number = {6},
	urldate = {2023-12-12},
	journal = {Geometric and Functional Analysis},
	author = {Conlon, David and Fox, Jacob and Sudakov, Benny},
	month = dec,
	year = {2010},
	pages = {1354--1366},
}

