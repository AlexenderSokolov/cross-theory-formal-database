	url = {http://arxiv.org/abs/2301.10147},
	abstract = {In 1977, Erd{\textbackslash}H\{o\}s and Hajnal made the conjecture that, for every graph \$H\$, there exists \$c{\textgreater}0\$ such that every \$H\$-free graph \$G\$ has a clique or stable set of size at least \${\textbar}G{\textbar}{\textasciicircum}c\$; and they proved that this is true with \$ {\textbar}G{\textbar}{\textasciicircum}c\$ replaced by \$2{\textasciicircum}\{c{\textbackslash}sqrt\{{\textbackslash}log {\textbar}G{\textbar}\}\}\$. Until now, there has been no improvement on this result (for general \$H\$). We prove a strengthening: that for every graph \$H\$, there exists \$c{\textgreater}0\$ such that every \$H\$-free graph \$G\$ with \${\textbar}G{\textbar}{\textbackslash}ge 2\$ has a clique or stable set of size at least \$\$2{\textasciicircum}\{c{\textbackslash}sqrt\{{\textbackslash}log {\textbar}G{\textbar}{\textbackslash}log{\textbackslash}log{\textbar}G{\textbar}\}\}.\$\$ Indeed, we prove the corresponding strengthening of a theorem of Fox and Sudakov, which in turn was a common strengthening of theorems of R{\textbackslash}"odl, Nikiforov, and the theorem of Erd{\textbackslash}H\{o\}s and Hajnal mentioned above.},
	language = {en},
	urldate = {2023-11-27},
	publisher = {arXiv},
	author = {Bucić, Matija and Nguyen, Tung and Scott, Alex and Seymour, Paul},
	month = jul,
