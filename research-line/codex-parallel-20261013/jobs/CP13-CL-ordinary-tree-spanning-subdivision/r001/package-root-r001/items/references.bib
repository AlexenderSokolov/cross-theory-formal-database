	author = {Lucchini, A.},
	month = oct,
	year = {2022},
	pages = {295--299},
}

@article{abdollahi_bh_2006,
	title = {B.{H}. {Neumann}'s {Question} on {Ensuring} {Commutativity} of {Finite} {Groups}},
	volume = {74},
	issn = {0004-9727, 1755-1633},
	url = {https://www.cambridge.org/core/product/identifier/S000497270004750X/type/journal_article},
	doi = {10.1017/S000497270004750X},
	abstract = {This paper is an attempt to provide a partial answer to the following question put forward by Bernhard H. Neumann in 2000: “Let
              G
              be a finite group of order
              g
              and assume that however a set
              M
              of
              m
              elements and a set
              N
              of
              n
              elements of the group is chosen, at least one element of
              M
              commutes with at least one element of
              N
              . What relations between
              g, m, n
              guarantee that
              G
              is Abelian?” We find an exponential function
              f
              (
              m,n
              ) such that every such group
              G
              is Abelian whenever {\textbar}
              G
              {\textbar} {\textgreater}
              f
              (
              m,n
              ) and this function can be taken to be polynomial if
              G
              is not soluble. We give an upper bound in terms of
              m
              and
              n
              for the solubility length of
              G
              , if
              G
              is soluble.},
	language = {en},
	number = {1},
	urldate = {2023-04-27},
	journal = {Bulletin of the Australian Mathematical Society},
	author = {Abdollahi, A. and Azad, A. and Hassanabadi, A. Mohammadi and Zarrin, M.},
	month = jan,
	year = {2006},
	pages = {121--132},
}

@article{fujita_color_2018,
