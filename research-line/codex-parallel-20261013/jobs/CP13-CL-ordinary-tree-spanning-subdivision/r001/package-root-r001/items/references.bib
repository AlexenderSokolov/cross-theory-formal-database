@misc{kavaskar_boundes_2023,
	title = {Boundes for {Boxicity} of some classes of graphs},
	url = {http://arxiv.org/abs/2308.08240},
	abstract = {Let \$box(G)\$ be the boxicity of a graph \$G\$, \$G[H\_1,H\_2,{\textbackslash}ldots, H\_n]\$ be the \$G\$-generalized join graph of \$n\$-pairwise disjoint graphs \$H\_1,H\_2,{\textbackslash}ldots, H\_n\$, \$G{\textasciicircum}d\_k\$ be a circular clique graph (where \$k{\textbackslash}geq 2d\$) and \${\textbackslash}Gamma(R)\$ be the zero-divisor graph of a commutative ring \$R\$. In this paper, we prove that \${\textbackslash}chi(G{\textasciicircum}d\_k){\textbackslash}geq box(G{\textasciicircum}d\_k)\$, for all \$k\$ and \$d\$ with \$k{\textbackslash}geq 2d\$. This generalizes the results proved in {\textbackslash}cite\{Aki\}. Also we obtain that \$box(G[H\_1,H\_2,{\textbackslash}ldots,H\_n]){\textbackslash}leq {\textbackslash}mathop{\textbackslash}sum{\textbackslash}limits\_\{i=1\}{\textasciicircum}nbox(H\_i)\$. As a consequence of this result, we obtain a bound for boxicity of zero-divisor graph of a finite commutative ring with unity. In particular, if \$R\$ is a finite commutative non-zero reduced ring with unity, then \${\textbackslash}chi({\textbackslash}Gamma(R)){\textbackslash}leq box({\textbackslash}Gamma(R)){\textbackslash}leq 2{\textasciicircum}\{{\textbackslash}chi({\textbackslash}Gamma(R))\}-2\$. where \${\textbackslash}chi({\textbackslash}Gamma(R))\$ is the chromatic number of \${\textbackslash}Gamma(R)\$. Moreover, we show that if \$N= {\textbackslash}prod{\textbackslash}limits\_\{i=1\}{\textasciicircum}\{a\}p\_i{\textasciicircum}\{2n\_i\} {\textbackslash}prod{\textbackslash}limits\_\{j=1\}{\textasciicircum}\{b\}q\_j{\textasciicircum}\{2m\_j+1\}\$ is a composite number, where \$p\_i\$'s and \$q\_j\$'s are distinct prime numbers, then \$box({\textbackslash}Gamma({\textbackslash}mathbb\{Z\}\_N)){\textbackslash}leq {\textbackslash}big({\textbackslash}mathop{\textbackslash}prod{\textbackslash}limits\_\{i=1\}{\textasciicircum}\{a\}(2n\_i+1){\textbackslash}mathop{\textbackslash}prod{\textbackslash}limits\_\{j=1\}{\textasciicircum}\{b\}(2m\_j+2){\textbackslash}big)-{\textbackslash}big({\textbackslash}mathop{\textbackslash}prod{\textbackslash}limits\_\{i=1\}{\textasciicircum}\{a\}(n\_i+1){\textbackslash}mathop{\textbackslash}prod{\textbackslash}limits\_\{j=1\}{\textasciicircum}\{b\}(m\_j+1){\textbackslash}big)-1\$, where \${\textbackslash}mathbb\{Z\}\_N\$ is the ring of integers modulo \$N\$. Further, we prove that, \$box({\textbackslash}Gamma({\textbackslash}mathbb\{Z\}\_N))=1\$ if and only if either \$N=p{\textasciicircum}n\$ for some prime number \$p\$ and some positive integer \$n{\textbackslash}geq 2\$ or \$N=2p\$ for some odd prime number \$p\$.},
	language = {en},
	urldate = {2024-01-11},
	publisher = {arXiv},
	author = {Kavaskar, T.},
	month = aug,
	year = {2023},
	note = {arXiv:2308.08240 [math]},
	keywords = {Mathematics - Combinatorics},
}

@misc{chakraborti_almost_2024,
	title = {Almost spanning distance trees in subsets of finite vector spaces},
	url = {http://arxiv.org/abs/2306.12023},
	abstract = {For \$d{\textbackslash}ge 2\$ and an odd prime power \$q\$, consider the vector space \${\textbackslash}mathbb\{F\}\_q{\textasciicircum}d\$ over the finite field \${\textbackslash}mathbb\{F\}\_q\$, where the distance between two points \$(x\_1,{\textbackslash}ldots,x\_d)\$ and \$(y\_1,{\textbackslash}ldots,y\_d)\$ is defined as \${\textbackslash}sum\_\{i=1\}{\textasciicircum}d (x\_i-y\_i){\textasciicircum}2\$. A distance graph is a graph associated with a non-zero distance to each of its edges. We show that large subsets of vector spaces over finite fields contain every nearly spanning distance tree with bounded degree in each distance. This quantitatively improves results by Bennett, Chapman, Covert, Hart, Iosevich, and Pakianathan on finding distance paths, and results by Pham, Senger, Tait, and Thu on finding distance trees. A key ingredient in proving our main result is to obtain a colorful generalization of a classical result of Haxell about finding nearly spanning bounded-degree trees in an expander.},
	language = {en},
	urldate = {2024-01-11},
	publisher = {arXiv},
	author = {Chakraborti, Debsoumya and Lund, Ben},
	month = jan,
	year = {2024},
	note = {arXiv:2306.12023 [math]},
	keywords = {Mathematics - Combinatorics},
}

@article{jiang_turexponents_2022,
	title = {On {Tur}{\textbackslash}'an exponents of bipartite graphs},
	volume = {31},
	issn = {0963-5483, 1469-2163},
	url = {http://arxiv.org/abs/1806.02838},
	doi = {10.1017/S0963548321000341},
	abstract = {A long-standing conjecture of Erdo˝s and Simonovits asserts that for every rational number r ∈ (1, 2) there exists a bipartite graph H such that ex(n, H) = Θ(nr). So far this conjecture is known to be true only for rationals of form 1 + 1/k and 2 − 1/k, for integers k ≥ 2. In this paper we add a new form of rationals for which the conjecture is true; 2 − 2/(2k + 1), for k ≥ 2. This in its turn also gives an aﬃrmative answer to a question of Pinchasi and Sharir on cube-like graphs. Recently, a version of Erdo˝s and Simonovits’s conjecture where one replaces a single graph by a family, was conﬁrmed by Bukh and Conlon. They proposed a construction of bipartite graphs which should satisfy Erdo˝s and Simonovits’s conjecture. Our result can also be viewed as a ﬁrst step towards verifying Bukh and Conlon’s conjecture.},
	language = {en},
	number = {2},
	urldate = {2024-01-11},
	journal = {Combinatorics, Probability and Computing},
	author = {Jiang, Tao and Ma, Jie and Yepremyan, Liana},
	month = mar,
	year = {2022},
	note = {arXiv:1806.02838 [math]},
	keywords = {Mathematics - Combinatorics},
	pages = {333--344},
}

