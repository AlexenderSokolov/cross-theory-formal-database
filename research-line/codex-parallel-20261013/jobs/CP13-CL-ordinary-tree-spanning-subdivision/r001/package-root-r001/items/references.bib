@misc{nguyen_induced_2023,
	title = {Induced subgraph density. {V}. {All} paths approach {Erdos}-{Hajnal}},
	url = {http://arxiv.org/abs/2307.15032},
	abstract = {The Erd{\textbackslash}H\{o\}s-Hajnal conjecture says that for every graph \$H\$, there exists \$c{\textgreater}0\$ such that every \$H\$-free graph \$G\$ has a clique or stable set of size at least \$2{\textasciicircum}\{c{\textbackslash}log{\textbar}G{\textbar}\}\$ (a graph is ``\$H\$-free'' if no induced subgraph is isomorphic to \$H\$). The conjecture is known when \$H\$ is a path with at most four vertices, but remains open for longer paths. For the five-vertex path, Blanco and Buci{\textbackslash}'c recently proved a bound of \$2{\textasciicircum}\{c({\textbackslash}log {\textbar}G{\textbar}){\textasciicircum}\{2/3\}\}\$; for longer paths, the best existing bound is \$2{\textasciicircum}\{c({\textbackslash}log{\textbar}G{\textbar}{\textbackslash}log{\textbackslash}log{\textbar}G{\textbar}){\textasciicircum}\{1/2\}\}\$. We prove a much stronger result: for any path \$P\$, every \$P\$-free graph \$G\$ has a clique or stable set of size at least \$2{\textasciicircum}\{({\textbackslash}log {\textbar}G{\textbar}){\textasciicircum}\{1-o(1)\}\}\$. We strengthen this further, weakening the hypothesis that \$G\$ is \$P\$-free by a hypothesis that \$G\$ does not contain ``many'' copies of \$P\$, and strengthening the conclusion, replacing the large clique or stable set outcome with a ``near-polynomial'' version of Nikiforov's theorem.},
	language = {en},
	urldate = {2023-11-27},
	publisher = {arXiv},
	author = {Nguyen, Tung and Scott, Alex and Seymour, Paul},
	month = jul,
	year = {2023},
	note = {arXiv:2307.15032 [math]},
	keywords = {Mathematics - Combinatorics},
}

