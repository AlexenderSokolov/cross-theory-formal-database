@misc{dadush_new_2021,
	title = {A {New} {Framework} for {Matrix} {Discrepancy}: {Partial} {Coloring} {Bounds} via {Mirror} {Descent}},
	shorttitle = {A {New} {Framework} for {Matrix} {Discrepancy}},
	url = {http://arxiv.org/abs/2111.03171},
	abstract = {Motivated by the Matrix Spencer conjecture, we study the problem of finding signed sums of matrices with a small matrix norm. A well-known strategy to obtain these signs is to prove, given matrices \$A\_1, {\textbackslash}dots, A\_n {\textbackslash}in {\textbackslash}mathbb\{R\}{\textasciicircum}\{m {\textbackslash}times m\}\$, a Gaussian measure lower bound of \$2{\textasciicircum}\{-O(n)\}\$ for a scaling of the discrepancy body \${\textbackslash}\{x {\textbackslash}in {\textbackslash}mathbb\{R\}{\textasciicircum}n: {\textbackslash}{\textbar} {\textbackslash}sum\_\{i=1\}{\textasciicircum}n x\_i A\_i{\textbackslash}{\textbar} {\textbackslash}leq 1{\textbackslash}\}\$. We show this is equivalent to covering its polar with \$2{\textasciicircum}\{O(n)\}\$ translates of the cube \${\textbackslash}frac\{1\}\{n\} B{\textasciicircum}n\_{\textbackslash}infty\$, and construct such a cover via mirror descent. As applications of our framework, we show: \${\textbackslash}bullet\$ Matrix Spencer for Low-Rank Matrices. If the matrices satisfy \${\textbackslash}{\textbar}A\_i{\textbackslash}{\textbar}\_\{{\textbackslash}mathrm\{op\}\} {\textbackslash}leq 1\$ and \${\textbackslash}mathrm\{rank\}(A\_i) {\textbackslash}leq r\$, we can efficiently find a coloring \$x {\textbackslash}in {\textbackslash}\{{\textbackslash}pm 1{\textbackslash}\}{\textasciicircum}n\$ with discrepancy \${\textbackslash}{\textbar}{\textbackslash}sum\_\{i=1\}{\textasciicircum}n x\_i A\_i {\textbackslash}{\textbar}\_\{{\textbackslash}mathrm\{op\}\} {\textbackslash}lesssim {\textbackslash}sqrt\{n {\textbackslash}log ({\textbackslash}min(rm/n, r))\}\$. This improves upon the naive \$O({\textbackslash}sqrt\{n {\textbackslash}log r\})\$ bound for random coloring and proves the matrix Spencer conjecture when \$r m {\textbackslash}leq n\$. \${\textbackslash}bullet\$ Matrix Spencer for Block Diagonal Matrices. For block diagonal matrices with \${\textbackslash}{\textbar}A\_i{\textbackslash}{\textbar}\_\{{\textbackslash}mathrm\{op\}\} {\textbackslash}leq 1\$ and block size \$h\$, we can efficiently find a coloring \$x {\textbackslash}in {\textbackslash}\{{\textbackslash}pm 1{\textbackslash}\}{\textasciicircum}n\$ with \${\textbackslash}{\textbar}{\textbackslash}sum\_\{i=1\}{\textasciicircum}n x\_i A\_i {\textbackslash}{\textbar}\_\{{\textbackslash}mathrm\{op\}\} {\textbackslash}lesssim {\textbackslash}sqrt\{n {\textbackslash}log (hm/n)\}\$. Using our proof, we reduce the matrix Spencer conjecture to the existence of a \$O({\textbackslash}log(m/n))\$ quantum relative entropy net on the spectraplex. \${\textbackslash}bullet\$ Matrix Discrepancy for Schatten Norms. We generalize our discrepancy bound for matrix Spencer to Schatten norms \$2 {\textbackslash}le p {\textbackslash}leq q\$. Given \${\textbackslash}{\textbar}A\_i{\textbackslash}{\textbar}\_\{S\_p\} {\textbackslash}leq 1\$ and \${\textbackslash}mathrm\{rank\}(A\_i) {\textbackslash}leq r\$, we can efficiently find a partial coloring \$x {\textbackslash}in [-1,1]{\textasciicircum}n\$ with \${\textbar}{\textbackslash}\{i : {\textbar}x\_i{\textbar} = 1{\textbackslash}\}{\textbar} {\textbackslash}ge n/2\$ and \${\textbackslash}{\textbar}{\textbackslash}sum\_\{i=1\}{\textasciicircum}n x\_i A\_i{\textbackslash}{\textbar}\_\{S\_q\} {\textbackslash}lesssim {\textbackslash}sqrt\{n {\textbackslash}min(p, {\textbackslash}log(rk))\} {\textbackslash}cdot k{\textasciicircum}\{1/p-1/q\}\$, where \$k := {\textbackslash}min(1,m/n)\$.},
	language = {en},
	urldate = {2023-11-27},
	publisher = {arXiv},
	author = {Dadush, Daniel and Jiang, Haotian and Reis, Victor},
	month = nov,
