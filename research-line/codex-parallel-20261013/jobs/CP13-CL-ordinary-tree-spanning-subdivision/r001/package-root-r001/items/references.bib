	title = {Applying extremal graph theory to a question on finite groups},
	volume = {168},
	issn = {0236-5294, 1588-2632},
	url = {https://link.springer.com/10.1007/s10474-022-01263-w},
	doi = {10.1007/s10474-022-01263-w},
	abstract = {A word w ∈ Fr is said to satisfy a probability gap if there exists a constant δw {\textless} 1 such that, for any ﬁnite group G, if the probability that w(g1, g2, . . . , gr) = 1 in G is at least δw, then w is an identity in G. Moreover we say that a group G has the wt-property if however r subsets X1, . . . , Xr of G are chosen with {\textbar}X1{\textbar} = · · · = {\textbar}Xr{\textbar} = t, there exists (g1, . . . , gr) ∈ X1 × · · · × Xr such that w(g1, . . . , gr) = 1. We prove that if w satisﬁes a probability gap, then for every positive integer t there exists a constant ct such that if a ﬁnite group G satisﬁes the wt-property, then {\textbar}G{\textbar} ≤ ct or w is an identity in G.},
