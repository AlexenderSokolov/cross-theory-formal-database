	url = {https://linkinghub.elsevier.com/retrieve/pii/S0166218X16303110},
	doi = {10.1016/j.dam.2016.07.002},
	abstract = {Let G be a cubic graph with a perfect matching. An edge e of G is a forcing edge if it is contained in a unique perfect matching M, and the perfect matching M is called uniquely forced. In this paper, we show that a 3-connected cubic graph with a uniquely forced perfect matching is generated from K4 via Y → -operations, i.e., replacing a vertex by a triangle, and further a cubic graph with a uniquely forced perfect matching is 2-connected and contains a triangle. Our result generalizes a previous result of Jiang and Zhang (2011). The unique 3-edge-coloring conjecture asserts that a Petersen-minor-free cubic graph with a unique 3-edge-coloring must contain a triangle. Our result verifies that the unique 3-edge-coloring conjecture holds for a subfamily of uniquely 3-edge-colorable cubic graphs, namely cubic graphs with uniquely forced perfect matching.},
	language = {en},
	urldate = {2023-06-02},
	journal = {Discrete Applied Mathematics},
	author = {Wu, Yezhou and Ye, Dong and Zhang, Cun-Quan},
	month = dec,
	year = {2016},
	pages = {203--207},
}

@article{omidi_stars_2018,
	title = {Stars versus stripes {Ramsey} numbers},
	volume = {67},
	issn = {01956698},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0195669817301476},
	doi = {10.1016/j.ejc.2017.08.009},
	abstract = {For given simple graphs G1, G2, . . . , Gt , the Ramsey number R(G1, G2, . . . , Gt ) is the smallest positive integer n such that if the edges of the complete graph Kn are partitioned into t disjoint color classes giving t graphs H1, H2, . . . , Ht , then at least one Hi has a subgraph isomorphic to Gi. In this paper, for positive integers t1, t2, . . . , ts and n1, n2, . . . , nc the Ramsey number R(St1 , St2 , . . . , Sts , n1K2, n2K2, . . . , nc K2) is computed exactly, where nK2 denotes a matching (stripe) of size n, i.e., n pairwise disjoint edges and Sn is a star with n edges. This result generalizes and strengthens significantly a well-known result of Cockayne and Lorimer and also a known result of Gyárfás and Sárközy.},
	language = {en},
	urldate = {2023-06-02},
	journal = {European Journal of Combinatorics},
	author = {Omidi, G.R. and Raeisi, G. and Rahimi, Z.},
	month = jan,
	year = {2018},
	pages = {268--274},
}

