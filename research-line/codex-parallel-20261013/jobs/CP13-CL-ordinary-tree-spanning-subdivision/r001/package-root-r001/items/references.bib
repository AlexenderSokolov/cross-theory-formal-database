@misc{sudakov_matrix_2023,
	title = {Matrix discrepancy and the log-rank conjecture},
	url = {http://arxiv.org/abs/2311.18524},
	abstract = {Given an \$m{\textbackslash}times n\$ binary matrix \$M\$ with \${\textbar}M{\textbar}=p{\textbackslash}cdot mn\$ (where \${\textbar}M{\textbar}\$ denotes the number of 1 entries), define the discrepancy of \$M\$ as \${\textbackslash}mbox\{disc\}(M)={\textbackslash}displaystyle{\textbackslash}max\_\{X{\textbackslash}subset [m], Y{\textbackslash}subset [n]\}{\textbackslash}big{\textbar}{\textbar}M[X{\textbackslash}times Y]{\textbar}-p{\textbar}X{\textbar}{\textbackslash}cdot {\textbar}Y{\textbar}{\textbackslash}big{\textbar}\$. Using semidefinite programming and spectral techniques, we prove that if \${\textbackslash}mbox\{rank\}(M){\textbackslash}leq r\$ and \$p{\textbackslash}leq 1/2\$, then \$\${\textbackslash}mbox\{disc\}(M){\textbackslash}geq {\textbackslash}Omega(mn){\textbackslash}cdot {\textbackslash}min{\textbackslash}left{\textbackslash}\{p,{\textbackslash}frac\{p{\textasciicircum}\{1/2\}\}\{{\textbackslash}sqrt\{r\}\}{\textbackslash}right{\textbackslash}\}.\$\$ We use this result to obtain a modest improvement of Lovett's best known upper bound on the log-rank conjecture. We prove that any \$m{\textbackslash}times n\$ binary matrix \$M\$ of rank at most \$r\$ contains an \$(m{\textbackslash}cdot 2{\textasciicircum}\{-O({\textbackslash}sqrt\{r\})\}){\textbackslash}times (n{\textbackslash}cdot 2{\textasciicircum}\{-O({\textbackslash}sqrt\{r\})\})\$ sized all-1 or all-0 submatrix, which implies that the deterministic communication complexity of any Boolean function of rank \$r\$ is at most \$O({\textbackslash}sqrt\{r\})\$.},
