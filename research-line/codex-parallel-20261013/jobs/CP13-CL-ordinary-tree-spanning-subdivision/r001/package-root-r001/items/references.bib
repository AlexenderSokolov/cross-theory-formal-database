@misc{nguyen_induced_2023-2,
	title = {Induced subgraph density. {III}. {The} pentagon and the bull},
	url = {http://arxiv.org/abs/2307.06379},
	abstract = {A theorem of R{\textbackslash}"odl says that for every graph \$H\$, and every \${\textbackslash}varepsilon{\textgreater}0\$, there exists \${\textbackslash}delta{\textgreater}0\$ such that if \$G\$ is a graph that has no induced subgraph isomorphic to \$H\$, then there exists \$X{\textbackslash}subseteq V(G)\$ with \${\textbar}X{\textbar}{\textbackslash}ge {\textbackslash}delta{\textbar}G{\textbar}\$ such that one of \$G[X],{\textbackslash}overline\{G\}[X]\$ has at most \${\textbackslash}varepsilon{\textbackslash}binom\{{\textbar}X{\textbar}\}\{2\}\$ edges. But for fixed \$H\$, how does \${\textbackslash}delta\$ depends on \${\textbackslash}varepsilon\$? If the dependence is polynomial, then \$H\$ satisfies the Erd{\textbackslash}H\{o\}s-Hajnal conjecture; and Fox and Sudakov conjectured that the dependence is polynomial for \{{\textbackslash}em every\} graph \$H\$. This conjecture is substantially stronger than the Erd{\textbackslash}H\{o\}s-Hajnal conjecture itself, and until recently it was not known to be true for any non-trivial graphs \$H\$. The preceding paper of this series showed that it is true for \$P\_4\$, and all graphs obtainable from \$P\_4\$ by vertex-substitution. Here we will show that the Fox-Sudakov conjecture is true for all the graphs \$H\$ that are currently known to satisfy the Erd{\textbackslash}H\{o\}s-Hajnal conjecture. In other words, we will show that it is true for the bull, and the 5-cycle, and induced subgraphs of them, and all graphs that can be obtained from these by vertex-substitution. There is a strengthening of R{\textbackslash}"odl's theorem due to Nikiforov, that replaces the hypothesis that \$G\$ has no induced subgraph isomorphic to \$H\$, with the weaker hypothesis that the density of induced copies of \$H\$ in \$G\$ is small. We will prove the corresponding ``polynomial'' strengthening of Nikiforov's theorem for the same class of graphs \$H\$.},
	language = {en},
	urldate = {2023-11-27},
	publisher = {arXiv},
	author = {Nguyen, Tung and Scott, Alex and Seymour, Paul},
	month = aug,
	year = {2023},
	note = {arXiv:2307.06379 [math]},
	keywords = {05C35, 05C42, 05C69, Mathematics - Combinatorics},
}

@misc{fox_induced_2023,
	title = {Induced subgraph density. {II}. {Sparse} and dense sets in cographs},
	url = {http://arxiv.org/abs/2307.00801},
	abstract = {A well-known theorem of R{\textbackslash}"odl says that for every graph \$H\$, and every \${\textbackslash}epsilon{\textgreater}0\$, there exists \${\textbackslash}delta{\textgreater}0\$ such that if \$G\$ does not contain an induced copy of \$H\$, then there exists \$X{\textbackslash}subseteq V(G)\$ with \${\textbar}X{\textbar}{\textbackslash}ge{\textbackslash}delta{\textbar}G{\textbar}\$ such that one of \$G[X],{\textbackslash}overline\{G\}[X]\$ has edge-density at most \${\textbackslash}epsilon\$. But how does \${\textbackslash}delta\$ depend on \${\textbackslash}epsilon\$? Fox and Sudakov conjectured that the dependence can be taken to be polynomial: for all \$H\$ there exists \$c{\textgreater}0\$ such that for all \${\textbackslash}epsilon{\textbackslash}in(0,1/2)\$, R{\textbackslash}"odl's theorem holds with \${\textbackslash}delta={\textbackslash}epsilon{\textasciicircum}c\$. This conjecture implies the Erd{\textbackslash}H\{o\}s-Hajnal conjecture, and until now it had not been verified for any non-trivial graphs \$H\$. Our first result shows that it is true when \$H=P\_4\$ (indeed, we can take \${\textbackslash}delta={\textbackslash}epsilon\$, and insist that one of \$G[X],{\textbackslash}overline\{G\}[X]\$ has maximum degree at most \${\textbackslash}epsilon{\textasciicircum}2{\textbar}G{\textbar}\$).) We will generalize this, and to do so, we need to work with an even stronger property. Let us say \$H\$ is \{{\textbackslash}em viral\} if there exists \$c{\textgreater}0\$ such that for all \${\textbackslash}epsilon{\textbackslash}in(0,1/2)\$, if \$G\$ contains at most \${\textbackslash}epsilon{\textasciicircum}c{\textbar}G{\textbar}{\textasciicircum}\{{\textbar}H{\textbar}\}\$ induced copies of \$H\$, then there exists \$X{\textbackslash}subseteq V(G)\$ with \${\textbar}X{\textbar}{\textbackslash}ge {\textbackslash}epsilon{\textasciicircum}c{\textbar}G{\textbar}\$ such that one of \$G[X],{\textbackslash}overline\{G\}[X]\$ has density at most \${\textbackslash}epsilon\$. We will show that \$P\_4\$ is viral, using a ``polynomial \$P\_4\$-removal lemma'' of Alon and Fox. We will also show that viral graphs are closed under vertex-substitution, and so all graphs that can be obtained by substitution from copies of \$P\_4\$ are viral. (In a subsequent paper, it will be shown that all graphs currently known to satisfy the Erd{\textbackslash}H\{o\}s-Hajnal conjecture are in fact viral.) Finally, we give a different strengthening of R{\textbackslash}"odl's theorem: we show that if \$G\$ does not contain an induced copy of \$P\_4\$, then its vertices can be partitioned into at most \$480{\textbackslash}epsilon{\textasciicircum}\{-4\}\$ subsets \$X\$ such that one of \$G[X],{\textbackslash}overline\{G\}[X]\$ has density at most \${\textbackslash}epsilon\$.},
	language = {en},
	urldate = {2023-11-27},
	publisher = {arXiv},
	author = {Fox, Jacob and Nguyen, Tung and Scott, Alex and Seymour, Paul},
	month = jul,
	year = {2023},
	note = {arXiv:2307.00801 [math]},
	keywords = {Mathematics - Combinatorics},
}

