@article{carlucciWeakStrongRestrictions2016,
    title = {"{Weak} yet strong" restrictions of {Hindman}'s {Finite} {Sums} {Theorem}},
    url = {http://arxiv.org/abs/1610.07500},
    abstract = {We present a natural restriction of Hindman’s Finite Sums Theorem that admits a simple combinatorial proof (one that does not also prove the full Finite Sums Theorem) and low computability-theoretic and proof-theoretic upper bounds, yet implies the existence of the Turing Jump, thus realizing the only known lower bound for the full Finite Sums Theorem. This is the ﬁrst example of this kind. In fact we isolate a rich family of similar restrictions of Hindman’s Theorem with analogous properties.},
    language = {en},
    urldate = {2020-11-16},
    journal = {arXiv:1610.07500 [math]},
    author = {Carlucci, Lorenzo},
    month = oct,
    year = {2016},
    note = {arXiv: 1610.07500},
    keywords = {Mathematics - Combinatorics, Mathematics - Logic},
}
@article{carlucciWeakVariantHindman2017,
    title = {A weak variant of {Hindman}'s {Theorem} stronger than {Hilbert}'s {Theorem}},
    url = {http://arxiv.org/abs/1610.05445},
    abstract = {Hirst investigated a slight variant of Hindman’s Finite Sums Theorem – called Hilbert’s Theorem – and proved it equivalent over RCA0 to the Inﬁnite Pigeonhole Principle. This gave the ﬁrst example of a ﬁnitistically reducible variant of Hindman’s Theorem. We here introduce another natural variant of Hindman’s Theorem – which we name the Adjacent Hindman’s Theorem – and prove it to be strictly stronger than the Inﬁnite Pigeonhole Principle and at most as strong as Ramsey’s Theorem for colorings of pairs in 2 colors (in the sense of Reverse Mathematics). In the Adjacent Hindman’s Theorem homogeneity is required only for ﬁnite sums of adjacent elements.},
    language = {en},
    urldate = {2020-11-16},
    journal = {arXiv:1610.05445 [math]},
    author = {Carlucci, Lorenzo},
    month = jan,
    year = {2017},
    note = {arXiv: 1610.05445},
    keywords = {Mathematics - Combinatorics, Mathematics - Logic},
}

