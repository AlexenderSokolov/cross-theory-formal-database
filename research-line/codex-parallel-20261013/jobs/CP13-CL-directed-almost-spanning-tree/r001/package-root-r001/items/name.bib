@misc{han_spanning_2023,
	title = {Spanning trees in sparse expanders},
	url = {http://arxiv.org/abs/2211.04758},
	abstract = {Given integers \$n{\textbackslash}ge {\textbackslash}Delta{\textbackslash}ge 2\$, let \${\textbackslash}mathcal\{T\}(n, {\textbackslash}Delta)\$ be the collection of all \$n\$-vertex trees with maximum degree at most \${\textbackslash}Delta\$. A question of Alon, Krivelevich and Sudakov in 2007 asks for determining the best possible spectral gap condition forcing an \$(n, d,{\textbackslash}lambda)\$-graph to be \${\textbackslash}mathcal\{T\}(n, {\textbackslash}Delta)\$-universal, namely, it contains all members of \${\textbackslash}mathcal\{T\}(n, {\textbackslash}Delta)\$ as a subgraph simultaneously. In this paper we show that for sufficiently large integer \$n\$ and all \${\textbackslash}Delta{\textbackslash}in {\textbackslash}mathbb\{N\}\$, every \$(n, d,{\textbackslash}lambda)\$-graph with {\textbackslash}[ {\textbackslash}lambda{\textbackslash}le{\textbackslash}frac\{d\}\{2{\textbackslash}Delta{\textasciicircum}\{5{\textbackslash}sqrt\{{\textbackslash}log n\}\}\} {\textbackslash}] is \${\textbackslash}mathcal\{T\}(n, {\textbackslash}Delta)\$-universal. As an immediate corollary, this implies that Alon's ingenious construction of triangle-free sparse expander is \${\textbackslash}mathcal\{T\}(n, {\textbackslash}Delta)\$-universal, which provides an explicit construction of such graphs and thus solves a question of Johannsen, Krivelevich and Samotij. Our main result is formulated under a much more general context, namely, the \$(n,d)\$-expanders. More precisely, we show that there exist absolute constants \$C,c{\textgreater}0\$ such that the following statement holds for sufficiently large integer \$n\$. (1).For all \${\textbackslash}Delta{\textbackslash}in {\textbackslash}mathbb\{N\}\$, every \$(n, {\textbackslash}Delta{\textasciicircum}\{5{\textbackslash}sqrt\{{\textbackslash}log n\}\})\$-expander is \${\textbackslash}mathcal\{T\}(n, {\textbackslash}Delta)\$-universal. (2).For all \${\textbackslash}Delta{\textbackslash}in {\textbackslash}mathbb\{N\}\$ with \${\textbackslash}Delta {\textbackslash}le c{\textbackslash}sqrt\{n\}\$, every \$(n, C{\textbackslash}Delta n{\textasciicircum}\{1/2\})\$-expander is \${\textbackslash}mathcal\{T\}(n, {\textbackslash}Delta)\$-universal. Both results significantly improve a result of Johannsen, Krivelevich and Samotij, and have further implications in locally sparse expanders and Maker-Breaker games that also improve previously known results drastically.},
	language = {en},
	urldate = {2024-02-12},
	publisher = {arXiv},
	author = {Han, Jie and Yang, Donglei},
	year = {2023},
	note = {arXiv:2211.04758 [math]},
	keywords = {Mathematics - Combinatorics},
}

