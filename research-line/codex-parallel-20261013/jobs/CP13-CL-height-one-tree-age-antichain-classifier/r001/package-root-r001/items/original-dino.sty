\ProcessKeyvalOptions*
%\ifdino@draft
%\onehalfspacing
\providecommand{\impmark}[1]{\strut\vadjust{\domark{\textcolor{#1}{$\blacktriangleright\blacktriangleright\blacktriangleright$}}}}
\providecommand{\domark}[1]{%
  \vbox to 0pt{
    \kern-\dp\strutbox
    \hbox{\smash{\llap{#1\kern1em}}}
    \vss
  }%
}
%\fi
% Print notes if draft, otherwise hide them
\ifdino@draftprint
  \providecommand{\combox}[2]{\fbox{\begin{minipage}{\textwidth}\textcolor{#2}{#1}\end{minipage}}}
\providecommand{\comment}[1]{\impmark{gray}\ \textcolor{darkgray}{#1}}
  \providecommand{\impcomm}[1]{\impmark{black}\ \combox{#1}}
  \providecommand{\dinocom}[1]{Dino\impmark{gray}\ \textcolor{darkgray}{\combox{#1}}}
\fi

\ifdino@draft
  
  \RequirePackage{showlabels}
  \providecommand{\comment}[1]{\impmark{blue}\ \textcolor{blue}{#1}}
  \providecommand{\impcomm}[1]{\impmark{red}\ \textcolor{red}{#1}}
  \providecommand{\dinocom}[1]{Dino\impmark{blue}\ \textcolor{blue}{#1}}

\else
  \providecommand{\comment}[1]{}
  \providecommand{\impcomm}[1]{}
  \providecommand{\dinocom}[1]{}
\fi
\ifdino@numeric
\RequirePackage[
            backend=biber,
            style=numeric,
            url=false,
            maxnames=10,
            minnames=5
]{biblatex}
\else
\RequirePackage[
            backend=biber,
            style=alphabetic,
            url=false,
            maxnames=10,
            minnames=5
]{biblatex}
\fi
\ifluatex
  \RequirePackage{fontspec}
  \RequirePackage{selnolig}  % disable illegal ligatures
\fi


