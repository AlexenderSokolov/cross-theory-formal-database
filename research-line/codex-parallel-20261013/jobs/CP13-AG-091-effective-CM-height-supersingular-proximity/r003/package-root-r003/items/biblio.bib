@article{papaszp,
	author = {Papas, G.},
	title = "{Some cases of the {Z}ilber–{P}ink {C}onjecture for curves in $\mathcal{A}_g$}",
	journal = {International Mathematics Research Notices},
	pages = {rnad201},
	year = {2023},
	month = {08},
