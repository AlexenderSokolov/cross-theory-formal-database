@article{ShareshianWachs2016Chromatic,
title = {Chromatic quasisymmetric functions},
journal = {Advances in Mathematics},
volume = {295},
pages = {497-551},
year = {2016},
issn = {0001-8708},
doi = {https://doi.org/10.1016/j.aim.2015.12.018},
url = {https://www.sciencedirect.com/science/article/pii/S0001870816000025},
author = {Shareshian, John and Wachs, Michelle L},
keywords = {Symmetric functions, Eulerian polynomials, -Positivity, Unimodality, Hessenberg varieties},
abstract = {We introduce a quasisymmetric refinement of Stanley's chromatic symmetric function. We derive refinements of both Gasharov's Schur-basis expansion of the chromatic symmetric function and Chow's expansion in Gessel's basis of fundamental quasisymmetric functions. We present a conjectural refinement of Stanley's power sum basis expansion, which we prove in special cases. We describe connections between the chromatic quasisymmetric function and both the q-Eulerian polynomials introduced in our earlier work and, conjecturally, representations of symmetric groups on cohomology of regular semisimple Hessenberg varieties, which have been studied by Tymoczko and others. We discuss an approach, using the results and conjectures herein, to the e-positivity conjecture of Stanley and Stembridge for incomparability graphs of (3+1)-free posets.}
}

