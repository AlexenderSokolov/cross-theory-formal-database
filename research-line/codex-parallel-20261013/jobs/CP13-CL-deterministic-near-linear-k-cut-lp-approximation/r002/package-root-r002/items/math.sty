% Lists for mathy situations
%% List of results
\newenvironment{mathproperties}{       %
  \everymath{\displaystyle}
  \begin{enumerate}[label={(\alph*)}]
  }{
  \end{enumerate}
}
%% List of properties
\newenvironment{mathresults}{ %
  \everymath{\displaystyle}
  \begin{enumerate}[label={(\roman*)}]
  }{
  \end{enumerate}
}


\newenvironment{exitems}{
  \everymath{\displaystyle}
  \begin{enumerate}[label={(\roman*)}]
  }{
  \end{enumerate}
}


\newenvironment{mathitems}{
  \everymath{\displaystyle}
  \begin{itemize}
  }{
  \end{itemize}
}

%% List of properties
\newenvironment{compactmathitem}{       %
  \everymath{\displaystyle}
  \begin{itemize}
  }{
  \end{itemize}
}


