      \field{labeltitlesource}{title}
      \field{abstract}{We study possible Scott sentence complexities of linear orderings using two approaches. First, we investigate the effect of the Friedman--Stanley embedding on Scott sentence complexity and show that it only preserves {$\Pi$}in{$\alpha\Pi\alpha$}in\textbackslash Pi \textasciicircum\{\textbackslash mathrm \{in\}\}\_\{\textbackslash alpha \} complexities. We then take a more direct approach and exhibit linear orderings of all Scott sentence complexities except {$\Sigma$}in3{$\Sigma$}3in\textbackslash Sigma \textasciicircum\{\textbackslash mathrm \{in\}\}\_\{3\} and {$\Sigma$}in{$\lambda$}+1{$\Sigma\lambda$}+1in\textbackslash Sigma \textasciicircum\{\textbackslash mathrm \{in\}\}\_\{\textbackslash lambda +1\} for {$\lambda\lambda\backslash$}lambda a limit ordinal. We show that the former cannot be the Scott sentence complexity of a linear ordering. In the process we develop new techniques which appear to be helpful to calculate the Scott sentence complexities of structures.}
      \field{eprinttype}{arXiv}
