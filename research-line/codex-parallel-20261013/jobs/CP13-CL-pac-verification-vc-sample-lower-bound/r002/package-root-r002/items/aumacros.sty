% See https://tex.stackexchange.com/questions/2607/spacing-around-left-and-right
\newcommand{\roundBrackets}[1]{
	\mathopen{}\left(#1\right)\mathclose{}
}

\newcommand{\squareBrackets}[1]{
	\mathopen{}\left[#1\right]\mathclose{}
}

