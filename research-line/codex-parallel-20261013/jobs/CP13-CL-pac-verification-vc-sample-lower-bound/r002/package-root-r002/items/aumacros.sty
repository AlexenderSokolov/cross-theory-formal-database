% Fractions

\newcommand{\reducedfractions}[3]{%
	\pgfmathtruncatemacro{\numerator}{#1/gcd(#1,#2)}%
	\pgfmathtruncatemacro{\denominator}{#2/gcd(#1,#2)}%
	\ifthenelse{\equal{\numerator}{\denominator}}{{#3}}{
		\ifthenelse{\equal{\numerator}{1}}{\frac{#3}{\denominator}}{
			\frac{\numerator{#3}}{\denominator}
		}	
	}
}

\newcommand{\sreducedfractions}[3]{%
	\pgfmathtruncatemacro{\numerator}{#1/gcd(#1,#2)}%
	\pgfmathtruncatemacro{\denominator}{#2/gcd(#1,#2)}%
	\ifthenelse{\equal{\numerator}{\denominator}}{{#3}}{
		\ifthenelse{\equal{\numerator}{1}}{\sfrac{#3}{\denominator}}{
			\sfrac{\numerator{#3}}{\denominator}
		}	
	}
}


