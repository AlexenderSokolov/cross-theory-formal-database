\newcommand{\labelstep}[1]{\label{step:#1}}
\newcommand{\refstep}[1]{{\normalfont\texttt{(\ref{step:#1})}}}
\newcommand{\refstepunpar}[1]{{\normalfont\texttt{\ref{step:#1}}}}
\newcommand{\refsubsteps}[1]{{\normalfont{\texttt{(\ref{step:#1}.*)}}}}

\newcommand{\retab}{\quad\=\quad\=\quad\=\quad\=\quad\=\quad\=\kill}

\newcounter{algoline}

% Naming algorithms
\newcommand{\algo}[1]{{\normalfont\texttt{#1}}}

% Code comments
\newcommand{\commentcode}[1]{{\color{ForestGreen} \small // #1}}
\newcommand{\commentitem}[1]{\item[\color{ForestGreen} \small //]
  {\color{ForestGreen} \small #1}}

\newcommand{\commentblock}[1]{\item[\color{ForestGreen} \small /*]
  {\color{ForestGreen} \small #1 */}}

\newenvironment{blockcomment}{%
\item[\color{ForestGreen} \small /*] \color{ForestGreen} \normalfont \itshape
}{%
  \hfill\texttt{*/}
}



\renewcommand{\commentcode}[1]{{\color{ForestGreen} //
    \normalfont\itshape#1}}
\renewcommand{\commentitem}[1]{\item[\color{ForestGreen}
  //]{\color{ForestGreen} \normalfont \itshape#1}}

\newenvironment{itemcomment}{%
\item[\color{ForestGreen} //] \color{ForestGreen} \normalfont \itshape
}{%
}


\newcommand{\assertcode}[1]{{\color{BrickRed} assert #1}}

\newenvironment{algorithm}[3][\textwidth]{
  \noindent%
  \begin{minipage}{#1}%
    \begin{framed}%
      \ttfamily\raggedright%
      \underline{#2%
        \IfNoValueF{#3}{(#3)}%
      }%
      \begin{steps}%
      }{
      \end{steps}%
    \end{framed}%
  \end{minipage}%
}


\newenvironment{implicitframed}[1][\textwidth]{
  \setlength{\FrameRule}{0pt}
  \begin{minipage}{#1}
    \begin{framed}
    }{
    \end{framed}
  \end{minipage}
}
