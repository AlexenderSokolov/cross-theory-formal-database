@article{MATSUMOTO201564,
  title    = {Generating 4-connected even triangulations on the sphere},
  journal  = {Discrete Mathematics},
  volume   = {338},
  number   = {1},
  pages    = {64-70},
  year     = {2015},
  issn     = {0012-365X},
  doi      = {https://doi.org/10.1016/j.disc.2014.08.017},
  url      = {https://www.sciencedirect.com/science/article/pii/S0012365X14003409},
  author   = {Naoki Matsumoto and Atsuhiro Nakamoto},
  keywords = {Generating theorem, 4-connected, Even triangulations, Sphere},
  abstract = {In this paper, we prove that every 4-connected even triangulation on the sphere can be obtained from the octahedron by a sequence of two kinds of transformations called a 4-splitting and a twin-splitting, only through 4-connected even triangulations. As a corollary, taking a dual, we can also generate all cyclically 4-edge-connected cubic bipartite graphs on the sphere.}
}

