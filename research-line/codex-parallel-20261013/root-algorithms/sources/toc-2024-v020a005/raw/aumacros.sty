%%% Macros used

%%%%% Paren-type macros
\newcommand{\floor}[1]{\left\lfloor #1 \right\rfloor}
\newcommand{\ceil}[1]{\left\lceil #1 \right\rceil}
\newcommand{\set}[1]{\left\{ #1 \right\}}
\newcommand{\abs}[1]{\left| #1 \right|}
\newcommand{\norm}[1]{\left\| #1 \right\|}
\newcommand{\inparen}[1]{\left( #1 \right)}
\newcommand{\insquare}[1]{\left[ #1 \right]}
\newcommand{\inbrace}[1]{\left\{ #1 \right\}}
\newcommand{\inangle}[1]{\left\langle #1 \right\rangle}
\newcommand{\pfrac}[2]{\inparen{\frac{#1}{#2}}}
\newcommand{\setdef}[2]{\inbrace{#1 \;:\; #2}}
\newcommand{\innerproduct}[2]{\inangle{#1,#2}}


%%%%% Some math symbol macros
\newcommand{\union}{\cup}
\newcommand{\Union}{\mathop{\bigcup}}
\newcommand{\intersection}{\cap}
\newcommand{\Intersection}{\mathop{\bigcap}}


%%%%% Some boldface letters
\newcommand{\veca}{\mathbf{a}}
\newcommand{\vecb}{\mathbf{b}}

%%%%% mathbb symbols
\newcommand{\F}{\mathbb{F}}
\newcommand{\E}{\mathbb{E}} % expectation

%%%%% Misc.
\newcommand{\X}{\mathcal{X}}