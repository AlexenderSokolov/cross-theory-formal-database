\newcommand{\newtype}[2]{\def#1{\@ifnextchar<{\@inewtype#2}{\@ifnextchar[{\@onewtype#2}{\@nnewtype#2}}}}

\def\@inewtype#1<#2>{\ensuremath{#1{#2}}}
\def\@onewtype#1[#2]#3{\expandafter\def\csname#2\endcsname{\@inewtype{#1}<#3>\xspace}}
\def\@nnewtype#1#2{\@onewtype{#1}[#2]{#2}}
