%% AU edit2
%% somehow, all \cref{} are expanded to Theorem XXX, so I fixed this issue by redefining theorem environments below:
\theoremstyle{plain}
\newtheorem{open}[theorem]{Open Question}
\let\lemma\undefined
\newtheorem{lemma}[theorem]{Lemma}
\let\corollary\undefined
\newtheorem{corollary}[theorem]{Corollary}
\let\claim\undefined
\newtheorem{claim}[theorem]{Claim}
\let\proposition\undefined
\newtheorem{proposition}[theorem]{Proposition}
\let\fact\undefined
\newtheorem{fact}[theorem]{Fact}
\let\conjecture\undefined
\newtheorem{conjecture}[theorem]{Conjecture}

\theoremstyle{definition}
\let\definition\undefined
\newtheorem{definition}[theorem]{Definition}
\let\example\undefined
\newtheorem{example}[theorem]{Example}
\let\remark\undefined
\newtheorem{remark}[theorem]{Remark}

\newenvironment{restatetheorem}[1]{\par \medskip \noindent \textbf{Restatement of \cref{\detokenize{#1}}.} \rmfamily}{\medskip}
\newenvironment{remindertheorem}[1]{\par \medskip \noindent \textbf{Reminder of \cref{\detokenize{#1}}.} \rmfamily}{\medskip}
\newenvironment{theoremref}[2][]{\par \medskip \noindent %
  \if\relax\detokenize{#1}\relax%
    \textbf{\cref{\detokenize{#2}}.}%
  \else%
    \textbf{\cref{\detokenize{#2}}} \textrm{(#1)}\textbf{.}%
  \fi\em}{\par \medskip}

