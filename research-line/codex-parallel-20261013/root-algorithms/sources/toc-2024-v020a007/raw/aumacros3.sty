\ProvidesPackage{aumacros}


%% Floor and ceiling

\newcommand{\floor}[1]{\left\lfloor #1\right\rfloor}
\newcommand{\ceil}[1]{\left\lceil #1\right\rceil}


%% Graphs

% neighbor used in matching
\newcommand{\Nbr}{N}

% subset of left side of bipartite graph
\newcommand{\A}{A}

% average degree
\newcommand{\avgdeg}{\deg_\mathrm{avg}}


%% Trees

% depth
\newcommand{\depth}{d}

% average depth
\newcommand{\avgdepth}{\depth_\mathrm{avg}}

% least common ancestor
\DeclareMathOperator{\LCA}{LCA}

% leaf set
\DeclareMathOperator{\leafset}{L}

% leaf children set
\DeclareMathOperator{\leafchildset}{LC}


%% Probability
% probability of an event
% used with square brackets if argument is a proposition; used with parentheses if argument is a subset of the sample space
\renewcommand{\Pr}{\mathbb{P}}

% indicator of event
% used with square brackets if argument is a proposition; used with parentheses if argument is a subset of the sample space
\newcommand{\Indicator}{\mathbb{I}}

% expected value of a random variable
% used with parenthesis around the argument
\newcommand{\Expect}{\mathbb{E}}

% normal random variable
\DeclareMathOperator{\Normal}{\mathcal{N}}

% random variable that is uniform on the integers from 0 to $n$
% $n$ is used as subscript
\newcommand{\UniformD}{U}

% random variable representing number of inversions in array of size $n$ distinct elements w.r.t. random ranking
% $n$ is used as subscript
\newcommand{\InvD}{\Inv}

% random variable representing number of cross inversions from array of size $a$ to array of size $b$ with all elements distinct w.r.t. random ranking
% $a$ and $b$ are used as subscripts
\newcommand{\XInvD}{\XInv}


%% Characteristic functions

% default notation for characteristic function
\DeclareMathOperator{\charfn}{\varphi}


%% Algorithm analysis

% polynomial 
\DeclareMathOperator{\poly}{poly}

% COST in dynamic programming
\newcommand{\Cost}{\textsc{Cost}}


%% Comparison model

% slot order
\newcommand{\slotorder}{<_\mathrm{slot}}


%% Inversion minimization on trees

% ranking
\newcommand{\ranking}{\rho}

% ordering (of tree or of children of a particular node)
\newcommand{\ordering}{\sigma}

% transposition
\newcommand{\transposition}{\tau}

% inversions 
% Can be used with no subscript and an array argument, or with a ranking as a subscript and another ranking as the argument. 
\DeclareMathOperator{\Inv}{Inv}

% cross inversions
% Can be used with no subscript and two arrays as argument, or with a ranking as a subscript and two sets as the argument.
\DeclareMathOperator{\XInv}{XInv}

% difference of cross inversions in one order vs the other
% Can be used with no subscript and two arrays as argument, or with a ranking as a subscript and two sets as the argument.
% Used with tree as subscript and ranking as the argument.
\DeclareMathOperator{\DInv}{DInv}

% minimum number of inversions in unordered tree w.r.t. ranking
% Arguments: tree, ranking
\DeclareMathOperator{\MInv}{MinInv}

% minimum number of inversions that cross the root in unordered tree w.r.t. ranking
% Arguments: tree, ranking
\DeclareMathOperator{\MRInv}{MinRInv}

% number of inversions that cross the root in unordered tree w.r.t. ranking for a given ordering of the children
% Arguments: tree, ranking, ordering
\DeclareMathOperator{\RInv}{RInv}

% subscripts to denote the lower and  higher of the two leaves affected by the transposition w.r.t. the ranking 
\newcommand{\lo}{\mathrm{lo}}
\newcommand{\hi}{\mathrm{hi}}


%% Gaussian polynomials

% bijection used in interval matching
\DeclareMathOperator{\bij}{\beta}

% set of all finite sums of the elements
\DeclareMathOperator{\Sum}{Sums}

% interior of a set
\DeclareMathOperator{\Int}{Int}

% q-analog
\newcommand{\qa}[2][q]{[{#2}]_{#1}}

% q-binomial coefficient
\newcommand{\qbinom}[3][q]{\binom{#2}{#3}_{#1}}

% coefficient of q-binomial coefficient
\newcommand{\G}{G}

%% TEST

% Generic probability distribution
\DeclareMathOperator{\dist}{\mathcal{D}}

% Number of execution traces
\DeclareMathOperator{\traces}{D}

% Deterministic complexity
\DeclareMathOperator{\DQ}{Q}

% Nondeterministic complexity
\DeclareMathOperator{\NQ}{N}

% Distributional complexity
\DeclareMathOperator{\DistQ}{DistQ}

% Randomized complexity
\DeclareMathOperator{\RQ}{RQ}

% Cost
\DeclareMathOperator{\cost}{cost}

% Shorthand for epsilon
\newcommand{\eps}{\varepsilon}