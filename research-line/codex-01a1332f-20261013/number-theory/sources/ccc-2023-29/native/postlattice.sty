\newcommand\@postABa[3]%
 {\clone{#1,#2+\ydp}{#3x}
  \clone{#1+\xdia,#2}{#30}
  \clone{#1-\xdia,#2}{#31}
  \clone{#1,#2-\ydp}{#32}
  \draw (#3x) -- (#30) -- (#32) -- (#31) -- (#3x);   
 }
\newcommand\@postABb[3]%
 {\clone{#1,#2+\ydp}{#3x}
  \clone{#1+\xDia,#2}{#30}
  \clone{#1-\xDia,#2}{#31}
  \clone{#1,#2-\ydp}{#32}
  \draw (#3x) -- (#30) -- (#32) -- (#31) -- (#3x);   
 }
\newcommand\@postABc[3]%
 {\clone{#1-\xPar,#2+\ydp}{#3x}
  \clone{#1+\xPar,#2-\ydp}{#30}
  \clone{#1+\xpar,#2}{#31}
  \clone{#1-\xpar,#2}{#32}
  \draw (#3x) -- (#31) -- (#30) -- (#32) -- (#3x);   
 }
\newcommand\@postABd[3]%
 {\clone{#1+\xPar,#2+\ydp}{#3x}
  \clone{#1-\xPar,#2-\ydp}{#30}
  \clone{#1-\xpar,#2}{#31}
  \clone{#1+\xpar,#2}{#32}
  \draw (#3x) -- (#31) -- (#30) -- (#32) -- (#3x);   
 }

