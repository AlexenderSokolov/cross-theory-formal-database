  \clone{#1+1.0,#2+0.5}{#30}
  \clone{#1-1.5,#2+0.5}{#31}
  \clone{#1,#2}{#32}
  \draw (#3x) -- (#30) -- (#32) -- (#31) -- (#3x);
 }
