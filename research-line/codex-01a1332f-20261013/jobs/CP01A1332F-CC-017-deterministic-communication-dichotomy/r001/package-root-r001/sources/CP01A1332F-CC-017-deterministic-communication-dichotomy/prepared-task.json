      {
        "claim_key": "doi:10.1007/s00037-025-00276-5:Theorem6.7",
        "difference": "Deterministic threshold admits AND/XOR and OR/XOR lifting; randomized threshold requires AND/OR and has logarithmic rather than constant nonlifting families."
      }
    ]
