  "standard_prerequisites": [
    {
      "name": "Real closedness of the Puiseux-series field",
      "source_reference": "Original reference [11], Basu–Pollack–Roy, Section 2.6",
      "use": "Interpreting first-order formulas over Puiseux series and over the real field"
    },
    {
      "name": "Quantifier elimination and quantitative degree/coefficient bounds",
      "source_reference": "Original reference [11], Theorems 2.77 and 14.6, and Corollary 10.4",
      "use": "Theorem 7 applies these standard bounds; the current author transfer proof is retained"
    },
    {
      "name": "Strong SDP duality under strict primal feasibility and a lower bound",
      "source_reference": "Original Theorem 2; reference [12], Ben-Tal–Nemirovski, Theorem 2.4.1",
      "use": "Attained dual optimum in the current author singleton encoding of Theorem 9"
    },
    {
      "name": "PSD principal-minor test and block-diagonal conjunctions; elementary bit-size arithmetic",
      "source_reference": "Original proof of Theorem 6 and Section 2.1; standard linear algebra and binary arithmetic",
      "use": "Transcribing polynomial-size LMI representations"
    }
  ],
  "core_obligations": [
    "Retain Theorem 6 in both directions: valuation of a feasible nonnegative Puiseux lift and monomial lift of a max-average solution, with the explicit quadratic-to-LMI encoding.",
    "Retain the complete Theorem 7 transfer argument: quantifier elimination with effective univariate bounds, Cauchy-root sign stabilization, and agreement of the Puiseux sign with sufficiently large real substitution.",
    "Retain Proposition 8 and the W-definition, including positive and negative rational exponents converted to integer polynomial equalities.",
    "Retain Theorem 9 in full: signed binary expansion, successive PSD blocks encoding the lower ray, strict feasibility, the attained strong-duality certificate imposing exact equality, and representation-size control.",
    "Retain the complete Corollary 10 proof: D, K and L construction, divisibility of c_j K, substitution by Theorem 9 singleton LMIs, polynomial-time construction and feasibility equivalence."
  ],
  "proof_roadmap": [
    "Theorem 6: Puiseux lifting and decoding",
    "Theorem 7 and Proposition 8: quantitative real substitution",
    "Theorem 9: compact exact singleton encoding using strong duality",
    "Corollary 10: denominator clearing and polynomial representation"
  ],
  "difficulty_level": "H2",
  "difficulty_reason": "H2: 本题承担从max-average CSP到有理系数实半正定可行性的实际多项式归约。作者先用Puiseux赋值实现双向编码，再用量词消去和Cauchy根界给出统一实参数转移，最后以带符号二进制PSD块及强对偶的达到性精确编码2^n，从而消除双指数系数的表示长度障碍。上述非例行编码、解码与位长控制全部保留在本题，未被改称背景。H3的独立研究级分级不额外认证，保守按H2。",
